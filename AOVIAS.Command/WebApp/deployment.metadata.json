{
  "schemaVersion": 1,
  "serviceId": "portal",
  "displayName": "Angular Portal",
  "releaseLibraryCategory": "Portal",
  "includeInDemoBundle": true,
  "includeInSolutionDeployment": true,
  "ports": {
    "containerPort": 80
  },
  "health": {
    "endpoint": "/",
    "expectedStatus": 200,
    "timeoutSeconds": 15,
    "retries": 2,
    "requiresHttpProbe": true
  },
  "dependencies": [
    { "service": "gateway", "required": true, "type": "service" }
  ]
}
