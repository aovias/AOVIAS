{
  "schemaVersion": 1,
  "serviceId": "identity-service",
  "displayName": "Identity Service",
  "releaseLibraryCategory": "Identity",
  "includeInDemoBundle": true,
  "includeInSolutionDeployment": true,
  "ports": {
