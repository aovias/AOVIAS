{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "FileRoot": null,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PerformanceObservability": {
    "Enabled": true,
    "DashboardTimingEnabled": true
  },
  "DashboardSummary": {
    "ExposeTimingHeaders": false
  },
  "DashboardProjection": {
    "Enabled": true,
    "ExposeDiagnosticsHeaders": false,
    "StaleAfterSeconds": 300
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Compliance;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "https://localhost:7135",
    "Audience": "https://localhost:7135"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Authentication": {
    "Authority": "https://localhost:7135"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "praman.events",
    "ExchangeType": "topic",
    "OutboxQueue": "compliance.outbox.relay",
    "FrameworkSnapshotQueue": "compliance.snapshot.framework",
    "ChapterSnapshotQueue": "compliance.snapshot.chapter",
    "OrganizationSnapshotQueue": "compliance.snapshot.organization",
    "DeadLetterExchange": "praman.dlx",
    "DeadLetterQueue": "compliance.dlq",
    "Retry": {
      "MaxRetryCount": 3,
      "InitialRetryDelaySeconds": 5,
      "MaxRetryDelaySeconds": 60,
      "UseExponentialBackoff": true
    },
    "PrefetchCount": 10,
    "ConnectionTimeout": 30
  },
  "Evidence": {
    "BulkUploadMaxFiles": 15,
    "MaxFileBytes": 10485760
  },
  "OrganizationService": {
    "BaseUrl": "https://localhost:7181"
  },
  "KnowledgeBaseService": {
    "BaseUrl": "https://localhost:7167"
