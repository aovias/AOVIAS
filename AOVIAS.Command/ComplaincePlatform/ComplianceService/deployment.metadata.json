{
  "schemaVersion": 1,
  "serviceId": "compliance-service",
  "displayName": "Compliance Service",
  "releaseLibraryCategory": "Compliance",
  "includeInDemoBundle": true,
  "includeInSolutionDeployment": true,
  "ports": {
    "containerPort": 5016
  },
  "health": {
    "endpoint": "/health",
    "expectedStatus": 200,
    "timeoutSeconds": 15,
    "retries": 3,
    "requiresHttpProbe": true
  },
  "dependencies": [
    { "service": "gateway", "required": true, "type": "service" },
    { "service": "organization-service", "required": true, "type": "service" }
  ]
}
