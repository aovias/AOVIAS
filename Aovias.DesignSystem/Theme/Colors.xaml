<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <Color x:Key="BackgroundColor">#090E1A</Color>
    <Color x:Key="SurfaceColor">#111827</Color>
    <Color x:Key="SurfaceElevatedColor">#162033</Color>
    <Color x:Key="SurfaceInsetColor">#0D1424</Color>
    <Color x:Key="BorderColor">#243044</Color>
    <Color x:Key="HoverColor">#1A2740</Color>
    <Color x:Key="SelectionColor">#12334A</Color>

    <!-- Brand -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryDeepColor">#1D4ED8</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="DeploymentColor">#A855F7</Color>
    <Color x:Key="AiColor">#14B8A6</Color>
    <Color x:Key="ComplianceColor">#6366F1</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
    <!-- Muted inset used by deployment workflow cards / console rows -->
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceInsetColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" Opacity="0.72" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDeepBrush" Color="{StaticResource PrimaryDeepColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="StatusHealthyBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="StatusDeploymentBrush" Color="{StaticResource DeploymentColor}" />
    <SolidColorBrush x:Key="StatusAiBrush" Color="{StaticResource AiColor}" />
    <SolidColorBrush x:Key="StatusComplianceBrush" Color="{StaticResource ComplianceColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Legacy aliases for existing views -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="PanelInsetBrush" Color="{StaticResource SurfaceInsetColor}" />
    <SolidColorBrush x:Key="BorderBrushMuted" Color="{StaticResource BorderColor}" Opacity="0.55" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource PrimaryDeepColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" Opacity="0.55" />
</ResourceDictionary>
