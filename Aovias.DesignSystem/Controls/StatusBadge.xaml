<UserControl x:Class="Aovias.DesignSystem.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Aovias.DesignSystem.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter" />
    </UserControl.Resources>

    <Border Padding="10,4"
            CornerRadius="12"
            Background="{DynamicResource SurfaceInsetBrush}"
            BorderBrush="{Binding StatusKind, ElementName=Root, Converter={StaticResource StatusKindToBrushConverter}}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7"
                     Height="7"
                     Margin="0,0,6,0"
                     VerticalAlignment="Center"
                     Fill="{Binding StatusKind, ElementName=Root, Converter={StaticResource StatusKindToBrushConverter}}" />
            <TextBlock Text="{Binding Text, ElementName=Root}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
