<UserControl x:Class="Aovias.DesignSystem.Controls.QuickActionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button Style="{StaticResource SecondaryButtonStyle}"
            Command="{Binding Command, ElementName=Root}"
            HorizontalContentAlignment="Stretch"
            Padding="0">
        <Border Style="{StaticResource CardBorderStyle}"
                Padding="16"
                Background="Transparent"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding IconGlyph, ElementName=Root}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,10" />
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource HeadingTextStyle}" />
                <TextBlock Text="{Binding Description, ElementName=Root}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Button>
</UserControl>
