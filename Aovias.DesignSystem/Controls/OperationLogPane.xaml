<UserControl x:Class="Aovias.DesignSystem.Controls.OperationLogPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMd}"
            Padding="14">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Execution Log" Style="{DynamicResource HeadingTextStyle}" FontSize="13.5" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox Text="{Binding SearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="180"
                             MinHeight="28"
                             Padding="8,4"
                             Margin="0,0,8,0"
                             ToolTip="Search log lines" />
                    <ToggleButton Content="Auto-scroll"
                                  IsChecked="{Binding AutoScroll, ElementName=Root}"
                                  MinHeight="28"
                                  Padding="10,4"
                                  Margin="0,0,8,0" />
                    <Button Content="Clear"
                            Command="{Binding ClearCommand, ElementName=Root}"
                            MinHeight="28"
                            Padding="10,4" />
                </StackPanel>
            </Grid>

            <ListBox x:Name="LogList"
                     ItemsSource="{Binding LogLines, ElementName=Root}"
                     Background="{DynamicResource SurfaceInsetBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Height="180"
                     FontFamily="Consolas"
                     FontSize="10.5"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
