<UserControl x:Class="Aovias.DesignSystem.Controls.TimelineEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Aovias.DesignSystem.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <Border Padding="12,10"
            Margin="0,0,0,8"
            CornerRadius="10"
            Background="{StaticResource SurfaceInsetBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Width="8"
                     Height="8"
                     Margin="0,6,12,0"
                     VerticalAlignment="Top"
                     Fill="{Binding StatusKind, ElementName=Root, Converter={StaticResource StatusKindToBrushConverter}}" />

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Style="{StaticResource BodyTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message, ElementName=Root}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding Message, ElementName=Root, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Timestamp, ElementName=Root}"
                           Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Text="{Binding Category, ElementName=Root}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,2,0,0"
                           Visibility="{Binding Category, ElementName=Root, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
