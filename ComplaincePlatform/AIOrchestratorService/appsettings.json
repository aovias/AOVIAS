{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "FileRoot": null,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=AIOrchestrator;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Services": {
    "ComplianceService": {
      "BaseUrl": "https://localhost:7087"
    },
    "KnowledgeBaseService": {
      "BaseUrl": "http://localhost:5120"
    },
    "CommunicationService": {
      "BaseUrl": ""
    }
  },
  "AIFeatureFlags": {
    "EnableAIRead": true,
    "EnableAIAssist": true,
    "EnableAIAction": true,
    "EnableAIProactive": false,
    "EnableAutonomousWorkflows": false,
    "EnableEventDrivenAutonomy": false,
    "EnableAutoExecution": false
  },
  "AIKnowledge": {
    "DefaultHospitalId": "",
    "DefaultFrameworkId": ""
  },
  "AIAce": {
    "DefaultHospitalId": "",
    "DefaultFrameworkId": "",
    "MonitorIntervalMinutes": 30
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "ApiVersion": "2024-10-21",
    "DefaultDeployment": "",
    "TenantDeploymentOverrides": {}
  },
  "AIProvider": "Sarvam",
  "AIProviderRouting": {
    "AIProvider": "Sarvam",
    "FallbackProvider": "AzureOpenAI",
    "D1AllowedUseCases": [
      "ExplainCompliance",
      "QueryCompliance",
      "SuggestMapping",
      "ValidateEvidence",
      "TaskRecommendation"
    ]
  },
  "Sarvam": {
    "ApiKey": "",
    "BaseUrl": "https://api.sarvam.ai",
    "Model": "sarvam-30b",
    "AuthMode": "Bearer",
    "TimeoutSeconds": 45,
    "MaxTokensPerRequest": 2048,
    "RetryCount": 1,
    "EnableFallbackToAzure": true
  },
  "AIRetrievalPolicy": {
    "MaxFindings": 20,
    "MaxEvidence": 20,
    "MaxTasks": 20,
    "MaxKBNodes": 20,
    "MaxObjectiveElements": 5,
    "MaxEvidenceItems": 3,
    "MaxFindingsItems": 3,
    "MaxContextTokens": 1200
  },
  "AIUsagePolicy": {
    "MaxRequestsPerSession": 50,
    "SessionWindowMinutes": 60,
    "PerTenantRateLimitPerMinute": 60
  },
  "AIPerformance": {
    "RequestTimeoutMs": 50000,
    "CacheTtlSeconds": 60,
    "EventDebounceSeconds": 20,
    "MaxInvocationsPerMinutePerTenant": 50
  },
  "AIConfidencePolicy": {
    "SuggestOnlyThreshold": 0.6,
    "WarnThreshold": 0.8
  },
  "AIEventProcessing": {
    "Enabled": false,
    "ServiceBusConnectionString": "",
    "TopicName": "compliance-events",
    "SubscriptionName": "ai-orchestrator-suggestions"
  },
  "AutonomyControl": {
    "EnableAutonomousWorkflows": false,
    "EnableEventDrivenAutonomy": false,
    "EnableAutoExecution": false,
    "ForceApprovalForAllActions": true,
    "RolloutStage": "D0",
    "MaxStepsPerWorkflow": 25,
    "MaxActionsPerSession": 50,
    "WorkflowTimeoutSeconds": 600,
    "StepTimeoutSeconds": 90,
    "ApprovalTimeoutSeconds": 1800,
    "RetryBudgetPerStep": 2,
    "StuckWorkflowThresholdSeconds": 180,
    "MaxEventTriggersPerEntityPerHour": 5
  },
  "AccessGovernanceService": {
    "BaseUrl": "https://localhost:7205"
  },
  "InternalApi": {
    "ApiKey": ""
  }
}
