	"item": [
		{
			"name": "_Auth",
			"item": [
				{
					"name": "Login (Get Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('access_token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "postman-client",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "postman-secret",
									"type": "text"
								},
								{
									"key": "username",
									"value": "user@example.com",
									"type": "text"
								},
								{
									"key": "password",
									"value": "Password123!",
									"type": "text"
								},
								{
									"key": "scope",
									"value": "openid profile organization.api compliance.api audit.api ai.api",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url_IdentityService}}/connect/token",
							"host": [
								"{{base_url_IdentityService}}"
							],
							"path": [
								"connect",
								"token"
							]
						},
						"description": "Authenticate and obtain JWT access token using Resource Owner Password grant. NOTE: Ensure IdentityConfig.cs includes all scopes (organization.api, compliance.api, audit.api, ai.api) and postman-client AllowedScopes includes them all."
					},
					"response": []
				},
				{
					"name": "Get Current User (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url_IdentityService}}/api/token/me",
							"host": [
								"{{base_url_IdentityService}}"
							],
							"path": [
								"api",
								"token",
								"me"
							]
						},
						"description": "Get current authenticated user claims"
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for Identity Service"
		},
