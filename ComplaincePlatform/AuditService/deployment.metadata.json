{
  "schemaVersion": 1,
  "serviceId": "audit-service",
  "displayName": "Audit Service",
  "releaseLibraryCategory": "Audit",
  "includeInDemoBundle": true,
  "includeInSolutionDeployment": true,
  "ports": {
    "containerPort": 5038
  },
  "health": {
    "endpoint": "/health",
    "expectedStatus": 200,
    "timeoutSeconds": 15,
    "retries": 3,
    "requiresHttpProbe": true
  },
  "dependencies": [
    { "service": "gateway", "required": true, "type": "service" },
    { "service": "compliance-service", "required": true, "type": "service" }
  ]
}
