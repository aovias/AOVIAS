{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "FileRoot": null,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "PerformanceObservability": {
    "DashboardTimingEnabled": true
  },
  "OnboardingWizard": {
    "UseEmailInvites": true
  },
  "WorkforceOnboarding": {
    "InvitationExpiryDays": 7,
    "DefaultEmploymentType": "Permanent",
    "RequireSeatDefault": true,
    "FailSeatIfUnavailable": true,
    "PublicAppBaseUrl": "http://localhost:4200",
    "AcceptPath": "/invitations/accept"
  },
  "Identity": {
    "EmailVerificationMode": "Async"
  },
  "TrialEnablement": {
    "AutoIssueOnSignup": true,
    "ValidDays": 30,
    "MaxSeats": 10,
    "GracePeriodDays": 7,
    "AutoActivate": true,
    "MachineFingerprintMode": "SignupHost",
    "Entitlements": [
      "core.compliance",
      "core.documents",
      "core.capa",
      "ai.assist",
      "ai.write",
      "governance.risk",
      "ace.insights",
      "frameworks"
    ],
    "DualWriteOrganizationSubscription": false,
    "SyncCatalogFromLicense": true,
    "DefaultTrialPlanId": null,
    "MaxExtensions": 2,
    "ExtensionDays": 15
  },
  "Licensing": {
    "FailClosedWrites": true,
    "EntitlementCacheSeconds": 30,
    "SyncCatalogFromLicense": true,
    "FeatureGates": {
      "/api/v1/ai/": "ai.write",
      "/api/v1/frameworks": "frameworks"
    },
    "AllowlistPathFragments": [
      "/commercial-admin",
      "/licenses/",
      "/licensing/",
      "/identity/auth",
      "/auth/",
      "/health",
      "/ops/",
      "password",
      "refresh",
      "/subscriptions"
    ]
  },
  "OnboardingExperience": {
    "PublicAppBaseUrl": "http://localhost:4200",
    "LoginPath": "/login",
    "DocsBaseUrl": "/docs",
    "SupportEmail": "support@aovias.com",
    "SendGettingStartedEmail": true
  },
  "TrialLifecycle": {
    "EnforceReadOnly": true
  },
  "Email": {
    "Provider": "Console"
  },
  "AIFeatureFlags": {
    "EnableAIRead": true,
    "EnableAIAssist": false,
    "EnableAIAction": true,
    "EnableAIProactive": false,
    "EnableAutonomousWorkflows": false,
    "EnableEventDrivenAutonomy": false,
    "EnableAutoExecution": false
  },
  "AllowedHosts": "*",
  "Installation": {
    "Completed": false
  },
  "JwtSettings": {
    "SecretKey": "",
    "PreviousSecretKey": "",
    "Issuer": "https://localhost:7135",
    "Audience": "https://localhost:7135",
    "ExpirationMinutes": 60
  },
  "KeyVault": {
    "VaultUri": "",
    "RequiredInProduction": false
  },
  "InternalApi": {
    "ApiKey": ""
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Services": {
    "GlobalProxy": {
      "DefaultHttpClientTimeoutSeconds": 100
    },
    "ComplianceService": {
      "BaseUrl": "http://complianceservice:7087",
      "HttpClientTimeoutSeconds": 150
    },
    "IdentityService": {
      "BaseUrl": "http://identityservice:7135"
    },
    "AIService": {
      "BaseUrl": "http://aiorchestratorservice:5003"
    },
    "KnowledgeBaseService": {
      "BaseUrl": "http://knowledgebaseservice:5120"
    },
    "PersonService": {
      "BaseUrl": "http://personservice:7190"
    },
    "WorkforceService": {
      "BaseUrl": "http://workforceservice:7195"
    },
    "ProfessionalService": {
      "BaseUrl": "http://professionalservice:7200"
    },
    "AccessGovernanceService": {
      "BaseUrl": "http://accessgovernanceservice:7205"
    },
    "GovernanceService": {
      "BaseUrl": "http://governanceservice:7210"
    },
    "CommunicationService": {
      "BaseUrl": "http://communicationservice:7215"
    },
    "WorkforceIntelligenceService": {
      "BaseUrl": "http://workforceintelligenceservice:7216"
    },
    "EnterpriseDirectoryService": {
      "BaseUrl": "http://enterprisedirectoryservice:7217"
    },
    "IntegrationService": {
      "BaseUrl": "http://integrationservice:7218"
    }
  },
  "InternalServices": {
    "OrganizationBaseUrl": "http://organizationservice:7181",
    "IdentityBaseUrl": "http://identityservice:7135"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "compliance-route": {
        "ClusterId": "compliance-cluster",
        "Match": {
          "Path": "/api/compliance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identityservice:7135"
          }
        }
      },
      "compliance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://complianceservice:7087"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://aiservice:7097"
          }
        }
      }
    }
  }
}
