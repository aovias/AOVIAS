{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm",
    "Issuer": "https://localhost:7135",
    "Audience": "https://localhost:7135",
    "ExpirationMinutes": 60
  },
  "InternalApi": {
    "ApiKey": "praman-internal-dev-key"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Services": {
    "GlobalProxy": {
      "DefaultHttpClientTimeoutSeconds": 100
    },
    "ComplianceService": {
      "BaseUrl": "http://localhost:5016",
      "HttpClientTimeoutSeconds": 150
    },
    "IdentityService": {
      "BaseUrl": "http://localhost:5062"
    },
    "CommunicationService": {
      "BaseUrl": "https://localhost:7215"
    },
    "OrganizationService": {
      "BaseUrl": "https://localhost:7181"
    },
    "AIService": {
      "BaseUrl": "https://localhost:7097"
    },
    "KnowledgeBaseService": {
      "BaseUrl": "http://localhost:5120"
    },
    "AccessGovernanceService": {
      "BaseUrl": "https://localhost:7205"
    },
    "EnterpriseDirectoryService": {
      "BaseUrl": "https://localhost:7217"
    },
    "WorkforceService": {
      "BaseUrl": "https://localhost:7195"
    },
    "PersonService": {
      "BaseUrl": "https://localhost:7190"
    },
    "ProfessionalService": {
      "BaseUrl": "https://localhost:7200"
    }
  },
  "RateLimiting": {
    "GlobalPermitLimitPerMinute": 5000
  },
  "InternalServices": {
    "OrganizationBaseUrl": "https://localhost:7181",
    "IdentityBaseUrl": "http://localhost:5062"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "compliance-route": {
        "ClusterId": "compliance-cluster",
        "Match": {
          "Path": "/api/compliance/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7135"
          }
        }
      },
      "compliance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5016"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7097"
          }
        }
      }
    }
  }
}
