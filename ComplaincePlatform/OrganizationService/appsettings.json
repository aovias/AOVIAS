{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "FileRoot": null,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Organization;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "https://localhost:7135",
    "Audience": "https://localhost:7135"
  },
  "CommunicationService": {
    "BaseUrl": "https://localhost:7215"
  },
  "InternalApi": {
    "ApiKey": ""
  },
  "OrganizationSettings": {
    "LogoMaxBytes": 2097152
  },
  "Email": {
    "Provider": "Console"
  },
  "TrialLifecycle": {
    "ReminderDays": [ 7, 3, 1 ],
    "GraceEndingReminderHours": 24,
    "EvaluationIntervalHours": 24,
    "BatchSize": 100,
    "EnforceReadOnly": true,
    "AutoSuspendOrganizationOnExpired": false,
    "HighSeatUsageThreshold": 0.8,
    "InternalAlertEmails": [],
    "SupportEmail": "support@aovias.com",
    "DocsBaseUrl": "/docs",
    "UpgradeInfoUrl": "/docs/upgrade",
    "CommercialAdminBaseUrl": "http://localhost:4200/commercial-admin",
    "PublicAppBaseUrl": "http://localhost:4200"
  },
  "Licensing": {
    "SyncCatalogFromLicense": true,
    "EntitlementCacheSeconds": 30,
    "DefaultCatalogPlanId": null
  },
  "WorkforceOnboarding": {
    "InvitationExpiryDays": 7,
    "DefaultEmploymentType": "Permanent",
    "RequireSeatDefault": true,
    "FailSeatIfUnavailable": true,
    "PublicAppBaseUrl": "http://localhost:4200",
    "AcceptPath": "/invitations/accept"
  }
}
