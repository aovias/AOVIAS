server {
    listen 443 ssl http2;
    server_name {{SERVER_NAME}};

    ssl_certificate {{SSL_CERTIFICATE_PATH}};
    ssl_certificate_key {{SSL_CERTIFICATE_KEY_PATH}};

    location {{PUBLIC_PATH_PREFIX}}/ {
        # Deployment packages are transferred as bounded chunks (4 MB by default).
        # Keep the proxy limit above the maximum supported chunk, never the full package size.
        client_max_body_size {{UPLOAD_BODY_LIMIT_MB}}m;
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        proxy_send_timeout {{UPLOAD_TIMEOUT_SECONDS}}s;
        proxy_read_timeout {{UPLOAD_TIMEOUT_SECONDS}}s;
        send_timeout {{UPLOAD_TIMEOUT_SECONDS}}s;
        proxy_pass http://{{UPSTREAM_HOST}}:{{UPSTREAM_PORT}}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix {{PUBLIC_PATH_PREFIX}};
    }

    location {{PUBLIC_PATH_PREFIX}}/hubs/ {
        proxy_pass http://{{UPSTREAM_HOST}}:{{UPSTREAM_PORT}}/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{UPLOAD_TIMEOUT_SECONDS}}s;
        proxy_send_timeout {{UPLOAD_TIMEOUT_SECONDS}}s;
    }
}
