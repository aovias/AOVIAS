{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hostinger Mail settings",
  "type": "object",
  "required": ["provider", "smtp", "defaults", "retry"],
  "properties": {
    "provider": { "const": "hostinger" },
    "displayName": { "type": "string" },
    "smtp": {
      "type": "object",
      "required": ["host", "ports", "recommended"],
      "properties": {
        "host": { "type": "string" },
        "ports": {
          "type": "object",
          "properties": {
            "starttls": { "type": "number" },
            "ssl": { "type": "number" }
          }
        },
        "recommended": {
          "type": "object",
          "properties": {
            "port": { "type": "number" },
            "secure": { "type": "boolean" },
            "requireTls": { "type": "boolean" },
            "authMethod": { "type": "string" }
          }
        },
        "sslAlternative": {
          "type": "object",
          "properties": {
            "port": { "type": "number" },
            "secure": { "type": "boolean" },
            "requireTls": { "type": "boolean" }
          }
        }
      }
    },
    "imap": { "type": "object" },
    "defaults": { "type": "object" },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": { "type": "number" },
        "initialDelayMs": { "type": "number" },
        "maxDelayMs": { "type": "number" },
        "factor": { "type": "number" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
