{
  "name": "aovias-web",
  "version": "1.1.0",
  "private": true,
  "description": "AOVIAS Public Website monorepo foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@aovias/website",
    "build": "npm run build --workspace=@aovias/website",
    "start": "npm run start --workspace=@aovias/website",
    "lint": "npm run lint --workspace=@aovias/website",
    "typecheck": "npm run typecheck --workspace=@aovias/website",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:local": "node scripts/ci-local.mjs",
    "release:package": "node scripts/create-release.mjs",
    "analyze": "node scripts/analyze-bundle.mjs",
    "budget:check": "node scripts/check-performance-budget.mjs",
    "lighthouse": "npm run lighthouse --workspace=@aovias/website",
    "deploy:local": "node deployment/scripts/deploy-local.mjs",
    "deploy:validate": "node deployment/scripts/validate-container.mjs",
    "docker:build": "docker build -f deployment/docker/Dockerfile --target runner -t aovias-website:r1 .",
    "docker:up": "docker compose -f deployment/compose/docker-compose.prod.yml up --build -d",
    "docker:down": "docker compose -f deployment/compose/docker-compose.prod.yml down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14"
  },
  "lint-staged": {
    "apps/website/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "npm run lint --workspace=@aovias/website --",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10"
}
