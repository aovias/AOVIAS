<UserControl x:Class="Aovias.DesignSystem.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource InsetPanelStyle}"
            HorizontalAlignment="Stretch"
            MinHeight="140">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420">
            <TextBlock Text="{Binding IconGlyph, ElementName=Root}"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="28"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource HeadingTextStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding Message, ElementName=Root}"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</UserControl>
