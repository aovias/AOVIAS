<UserControl x:Class="Aovias.DesignSystem.Controls.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="88"
             Height="88">
    <Grid>
        <Border Width="72"
                Height="72"
                CornerRadius="36"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="6"
                Background="{DynamicResource SurfaceInsetBrush}" />
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding Value, ElementName=Root, StringFormat={}{0:F0}%}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
