<Window x:Class="ComplianceServiceManager.Views.Development.CreateAgentSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Agent Session"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Agent (development agent — not Runtime Agent)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <ComboBox x:Name="AgentTypeBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Title" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="TitleBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Task ID (optional)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="TaskIdBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Workspace" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <ComboBox x:Name="WorkspaceBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Expected branch" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="BranchBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Runtime profile (optional)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <ComboBox x:Name="ProfileBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,0,0,10">
            <TextBlock Text="Local PR (optional)" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <ComboBox x:Name="PullRequestBox" MinHeight="32" />
        </StackPanel>
        <StackPanel Grid.Row="7" Margin="0,0,0,16">
            <TextBlock Text="Description" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Create Session" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Click="OnCreateClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
