<UserControl x:Class="ComplianceServiceManager.Views.Publishing.PublishingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:helpers="clr-namespace:ComplianceServiceManager.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             Loaded="PublishingView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:StepVisibilityConverter x:Key="StepVisibilityConverter" />
        <helpers:NotNullToVisibilityConverter x:Key="NotNullToVis" />

        <Style x:Key="StepSectionStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="StatChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ShortcutButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ TOP: entry mode + pipeline stepper ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <ToggleButton Content="Single Service Publish"
                                  IsChecked="{Binding IsSingleMode, Mode=OneWay}"
                                  Command="{Binding SelectEntryModeCommand}"
                                  CommandParameter="Single"
                                  Margin="0,0,8,0" />
                    <ToggleButton Content="Publish All Services"
                                  IsChecked="{Binding IsAllServicesMode, Mode=OneWay}"
                                  Command="{Binding SelectEntryModeCommand}"
                                  CommandParameter="All" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="640" />
                </StackPanel>

                <controls:DeploymentStepIndicator CurrentStepIndex="{Binding CurrentWizardStep}"
                                                  Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">
                    <controls:DeploymentStepIndicator.Steps>
                        <x:Array Type="sys:String">
                            <sys:String>Select Source</sys:String>
                            <sys:String>Project Analysis</sys:String>
                            <sys:String>Publishing Profile</sys:String>
                            <sys:String>Publish Package</sys:String>
                            <sys:String>Publishing Readiness</sys:String>
                            <sys:String>Release Library</sys:String>
                        </x:Array>
                    </controls:DeploymentStepIndicator.Steps>
                </controls:DeploymentStepIndicator>

                <controls:DeploymentStepIndicator CurrentStepIndex="{Binding BulkStep}"
                                                  Visibility="{Binding IsAllServicesMode, Converter={StaticResource BoolToVis}}">
                    <controls:DeploymentStepIndicator.Steps>
                        <x:Array Type="sys:String">
                            <sys:String>Select Services</sys:String>
                            <sys:String>Preflight</sys:String>
                            <sys:String>Publish Pipeline</sys:String>
                            <sys:String>Publishing Readiness</sys:String>
                            <sys:String>Release Library</sys:String>
                        </x:Array>
                    </controls:DeploymentStepIndicator.Steps>
                </controls:DeploymentStepIndicator>
            </StackPanel>
        </Border>

        <!-- ============ MAIN: source | step content | summary ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: source selection -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,14,0">
                <Grid>
                    <!-- Single: project picker -->
                    <Grid Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Select Project" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Choose a project to publish." Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search projects"
                                     Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ProjectKindFilters}"
                                      SelectedItem="{Binding SelectedKindFilter}"
                                      MinWidth="96" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProjectsView}" VirtualizingPanel.IsVirtualizing="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="{StaticResource SurfaceInsetBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Padding="12,9"
                                                Margin="0,0,0,7">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Kind}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="999"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding Port, Converter={StaticResource NotNullToVis}}">
                                                    <TextBlock Text="{Binding Port, StringFormat=:{0}}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="3"
                                Content="Browse for project…"
                                Command="{Binding BrowseProjectCommand}"
                                Margin="0,10,0,0" />
                    </Grid>

                    <!-- All: grouped service inclusion -->
                    <Grid Visibility="{Binding IsAllServicesMode, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Service Selection" Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="Every discovered deployable service is included in a solution publish."
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ServiceGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,0,0,5">
                                                            <TextBlock Text="{StaticResource IconHealth}"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SuccessBrush}"
                                                                       Margin="0,0,8,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding Projects.Count, StringFormat=All {0} services included}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,10,0,0" />
                    </Grid>
                </Grid>
            </Border>

            <!-- CENTER: dynamic step content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <Grid>
                    <!-- ===== Single mode steps ===== -->
                    <StackPanel Visibility="{Binding IsSingleMode, Converter={StaticResource BoolToVis}}">

                        <!-- Step 0: select source -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="0" />
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="Select Source" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="Pick a project from the list on the left, or browse to a project file. Selection starts the analysis automatically."
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <TextBlock Text="Project path" Style="{StaticResource FieldLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ManualProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Analyze" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AnalyzeProjectCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Step 1: analysis -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="1" />
                            </Border.Visibility>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Project Details" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="999" Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiscoveryResult.ProjectType}" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="9,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SelectedProjectDetails.TargetFramework}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Content="Continue to Profile →"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ContinueToProfileCommand}"
                                            HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="Path" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding SelectedProjectDetails.DirectoryPath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Service ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding DiscoveryResult.ServiceId}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Provider" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding DiscoveryResult.ProviderName}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Project File" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedProjectDetails.ProjectFile}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Last Modified" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding SelectedProjectDetails.LastModifiedDisplay}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource StatChipStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Files" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding SelectedProjectDetails.FileCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatChipStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Dependencies" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding SelectedProjectDetails.DependencyCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatChipStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Configurations" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding SelectedProjectDetails.ConfigurationCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatChipStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="Size (Disk)" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding SelectedProjectDetails.DiskSizeDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: profile -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="2" />
                            </Border.Visibility>
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Publishing Profile" Style="{StaticResource HeadingTextStyle}" />
                                    <Button Content="Continue to Publish →"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ContinueToPublishCommand}"
                                            HorizontalAlignment="Right" />
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,10">
                                        <TextBlock Text="Service ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding ServiceId, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Active Profile" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding ActiveProfile}" IsReadOnly="True" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Output Directory" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Version section -->
                                <Border Background="{StaticResource SurfaceInsetBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="Version" Style="{StaticResource HeadingTextStyle}" FontSize="13.5" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="Suggested:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2">
                                                    <TextBlock Text="{Binding SuggestedVersion}" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Version" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Build Number (optional)" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding BuildNumber, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Revision (optional)" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource CaptionTextStyle}">
                                                <Run Text="Will publish as: " />
                                                <Run Text="{Binding ComposedVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </TextBlock>
                                        </Grid>

                                        <Border Background="{StaticResource SurfaceElevatedBrush}"
                                                BorderBrush="{StaticResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Padding="10,8"
                                                Margin="0,8,0,0"
                                                Visibility="{Binding HasExistingVersion, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource IconWarning}" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding VersionExistsMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding ExistingVersions}" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Already-published notice: same version, identical content — publishing succeeded. -->
                        <Border Style="{StaticResource StepSectionStyle}"
                                BorderBrush="{StaticResource SuccessBrush}"
                                Visibility="{Binding ShowAlreadyPublishedNotice, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{StaticResource IconHealth}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="This version has already been published" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14">
                                    <Run Text="Version" /> <Run Text="{Binding ConflictRequestedVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="was already registered with identical content, so the Release Library treated this run as a no-op re-registration. Publishing completed successfully." />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open Release" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenReleaseFromNoticeCommand}" Margin="0,0,8,0" />
                                    <Button Content="Continue" Command="{Binding DismissAlreadyPublishedNoticeCommand}" Margin="0,0,8,0" />
                                    <Button Content="Close" Command="{Binding DismissAlreadyPublishedNoticeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Release Version Conflict: same version, different content — blocked by design. -->
                        <Border Style="{StaticResource StepSectionStyle}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Visibility="{Binding ShowVersionConflict, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource IconError}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Release Version Conflict" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="999" Padding="9,2" HorizontalAlignment="Right">
                                        <TextBlock Text="Different content detected" FontSize="10.5" Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Service" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding ServiceId}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Requested Version" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding ConflictRequestedVersion}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Existing Version" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBlock Text="{Binding ConflictExistingVersion}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- New-version confirmation sub-panel, opened by "Publish as New Version". -->
                                <Border Background="{StaticResource SurfaceInsetBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Padding="14"
                                        Margin="0,0,0,14"
                                        Visibility="{Binding ShowNewVersionPanel, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Publish Version" Style="{StaticResource HeadingTextStyle}" FontSize="13" Margin="0,0,0,10" />
                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Current Version" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding ConflictExistingVersion}" Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Suggested Version" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding NewVersionSuggestion}" Style="{StaticResource BodyTextStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="New Version" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Text="{Binding NewVersionInput, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding NewVersionValidationMessage}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding HasNewVersionValidationMessage, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Confirm and Continue Publishing"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding ConfirmNewVersionCommand}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Publish as New Version"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartPublishAsNewVersionCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Change Version" Command="{Binding ChangeVersionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Compare Releases" Command="{Binding CompareReleasesCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Command="{Binding CancelVersionConflictCommand}" />
                                </StackPanel>

                                <Expander Header="Technical details" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,0">
                                    <TextBox Text="{Binding ConflictTechnicalDetails, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Step 3: publish package -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="3" />
                            </Border.Visibility>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Publish Package" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentPipelineStep}" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel"
                                                Command="{Binding CancelPublishCommand}"
                                                Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Publish Package"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding PublishCommand}"
                                                IsEnabled="{Binding CanStartPublish}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding PublishProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding StageTimings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StageName}" Style="{StaticResource BodyTextStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Duration, StringFormat={}{0:mm\\:ss\\.f}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Step 4: readiness -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="4" />
                            </Border.Visibility>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Publishing Readiness" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ReadinessStatus}" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ReadinessScore, StringFormat=Score {0}}" Style="{StaticResource CaptionTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Re-validate" Command="{Binding ValidateArtifactCommand}" Margin="0,0,8,0" />
                                        <Button Content="Add to Release Library →"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding AddToReleaseLibraryCommand}"
                                                IsEnabled="{Binding CanAddToReleaseLibrary}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ReadinessStages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Deferred}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StageName}" Style="{StaticResource BodyTextStyle}" />
                                                    <TextBlock Text=" — Deferred (runs during deployment)"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Visibility>
                                                            <Binding Path="Deferred">
                                                                <Binding.Converter>
                                                                    <BooleanToVisibilityConverter />
                                                                </Binding.Converter>
                                                            </Binding>
                                                        </TextBlock.Visibility>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Duration, StringFormat={}{0:mm\\:ss\\.f}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ReadinessRecommendations}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander Header="Failure details" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                                          Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding FailureDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="11" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Step 5: release library -->
                        <Border Style="{StaticResource StepSectionStyle}">
                            <Border.Visibility>
                                <Binding Path="CurrentWizardStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="5" />
                            </Border.Visibility>
                            <StackPanel>
                                <TextBlock Text="Release Library" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,8" />
                                <TextBlock Text="The certified package is registered in the Release Library and is ready for deployment."
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="Package" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding PublishedPackagePath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                <TextBlock Text="Release Library" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding ReleaseLibraryPath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Open Deployments"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding OpenReleaseCenterCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Open Package Location" Command="{Binding OpenPublishedPackageCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== All-services mode ===== -->
                    <StackPanel Visibility="{Binding IsAllServicesMode, Converter={StaticResource BoolToVis}}">

                        <!-- Bulk step 0: Select Services -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="BulkStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="0" />
                            </StackPanel.Visibility>

                            <!-- Status banner -->
                            <Border Padding="18" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Danger">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Warning">
                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Success">
                                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="420">
                                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{StaticResource IconHealth}" />
                                                    <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Danger">
                                                            <Setter Property="Text" Value="{StaticResource IconError}" />
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Warning">
                                                            <Setter Property="Text" Value="{StaticResource IconWarning}" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BulkBannerSeverity}" Value="Success">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding BulkBannerTitle}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding BulkBannerSubtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Total Services" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkServices.Count}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Ready" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkReadyCount}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Warnings" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkWarningCount}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Errors" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkPlatformIssueCount}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}" Margin="0,0,14,0">
                                            <StackPanel>
                                                <TextBlock Text="Blocked" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkBlockedCount}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Content="Export Report" Command="{Binding ExportBulkReportCommand}" Margin="0,0,8,0" />
                                        <Button Content="Refresh" Command="{Binding RefreshBulkServicesCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Blocking issues -->
                            <Border Style="{StaticResource StepSectionStyle}" Visibility="{Binding HasBlockingIssues, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ToggleButton IsChecked="{Binding IsBlockingIssuesExpanded}"
                                                  Background="Transparent" BorderThickness="0" Padding="0" MinHeight="24"
                                                  HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource IconChevronRight}" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlockingIssuesExpanded}" Value="True">
                                                                <Setter Property="LayoutTransform">
                                                                    <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding BlockingIssues.Count, StringFormat=Blocking Issues ({0})}" Style="{StaticResource HeadingTextStyle}" FontSize="13.5" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <ItemsControl ItemsSource="{Binding BlockingIssues}" Margin="0,12,0,0"
                                                  Visibility="{Binding IsBlockingIssuesExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{StaticResource IconError}" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" MaxWidth="440" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Service}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="{StaticResource SurfaceInsetBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="999" Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="Blocker" FontSize="10" Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                    <Button Grid.Column="3" Content="{Binding ActionLabel}"
                                                            Command="{Binding DataContext.HandleBlockingIssueActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}"
                                                            HorizontalContentAlignment="Left" Padding="0" MinHeight="20" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Services table -->
                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding BulkServices.Count, StringFormat=Services ({0})}" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <TextBox Text="{Binding BulkServiceSearchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" ToolTip="Search services..." VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding BulkStatusFilters}" HorizontalAlignment="Right">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Command="{Binding DataContext.SelectBulkStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,8,0" Padding="10,4" MinHeight="26" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding BulkServicesView}"
                                              IsReadOnly="True"
                                              RowHeight="38"
                                              MaxHeight="360"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                                            <DataGridTextColumn Header="Current Version" Binding="{Binding CurrentVersion}" Width="*" />
                                            <DataGridTextColumn Header="Next Version" Binding="{Binding NextVersion}" Width="*" />
                                            <DataGridTemplateColumn Header="Status" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Readiness" Binding="{Binding Readiness}" Width="*" />
                                            <DataGridTemplateColumn Header="Issues" Width="1.4*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Issues}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasIssueAction}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness" Value="2,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Button Content="Validate Again" Command="{Binding RunPreflightCommand}" IsEnabled="{Binding CanRunPreflight}" />
                                <Button Content="Continue to Pipeline →"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ContinueBulkStepCommand}"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Bulk step 1: Preflight -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="BulkStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="1" />
                            </StackPanel.Visibility>
                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Preflight" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <TextBlock Text="Validation mode" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <ComboBox ItemsSource="{Binding DeploymentValidationModes}"
                                                      SelectedItem="{Binding DeploymentValidationMode}"
                                                      MinWidth="110"
                                                      VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="Run Preflight"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding RunPreflightCommand}"
                                                IsEnabled="{Binding CanRunPreflight}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding PreflightStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding PreflightBlockingReasons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Button Content="← Previous" Command="{Binding PreviousBulkStepCommand}" />
                                <Button Content="Continue to Publish Pipeline →"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ContinueBulkStepCommand}"
                                        IsEnabled="{Binding PreflightReady}"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Bulk step 2: Publish Pipeline -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="BulkStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="2" />
                            </StackPanel.Visibility>

                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Version Strategy" Style="{StaticResource HeadingTextStyle}" />
                                        <Button Content="Refresh Preview"
                                                Command="{Binding RefreshVersionPreviewCommand}"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Content="Keep Existing Versions" GroupName="VersionStrategy" Margin="0,0,18,0" VerticalAlignment="Center"
                                                     Command="{Binding SelectVersionStrategyCommand}" CommandParameter="Keep Existing Versions" />
                                        <RadioButton Content="Increment Patch" GroupName="VersionStrategy" Margin="0,0,18,0" VerticalAlignment="Center" IsChecked="True"
                                                     Command="{Binding SelectVersionStrategyCommand}" CommandParameter="Increment Patch" />
                                        <RadioButton Content="Increment Minor" GroupName="VersionStrategy" Margin="0,0,18,0" VerticalAlignment="Center"
                                                     Command="{Binding SelectVersionStrategyCommand}" CommandParameter="Increment Minor" />
                                        <RadioButton Content="Increment Major" GroupName="VersionStrategy" Margin="0,0,18,0" VerticalAlignment="Center"
                                                     Command="{Binding SelectVersionStrategyCommand}" CommandParameter="Increment Major" />
                                        <RadioButton Content="Custom Version Prefix" GroupName="VersionStrategy" VerticalAlignment="Center"
                                                     Command="{Binding SelectVersionStrategyCommand}" CommandParameter="Custom Version Prefix" />
                                    </StackPanel>

                                    <TextBox Text="{Binding CustomVersionPrefix, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="180"
                                             HorizontalAlignment="Left"
                                             Margin="0,0,0,12"
                                             Tag="Custom version (e.g. 2.0.0)">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VersionStrategy}" Value="Custom Version Prefix">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <DataGrid ItemsSource="{Binding VersionPreview}"
                                              RowHeight="34"
                                              MaxHeight="180"
                                              IsReadOnly="True"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*" />
                                            <DataGridTextColumn Header="Current Version" Binding="{Binding CurrentVersion}" Width="*" />
                                            <DataGridTemplateColumn Header="Next Version" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CurrentVersion}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,6,0" />
                                                            <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding NextVersion}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11.5" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Publish Pipeline" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Publish All Services"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding PublishSolutionCommand}"
                                                    IsEnabled="{Binding CanPublishSolution}"
                                                    Margin="0,0,8,0" />
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelSolutionPublishCommand}"
                                                    Visibility="{Binding IsSolutionPublishing, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SolutionPublishStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DiskUsageSummary}" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />
                                    <ProgressBar Value="{Binding PublishProgressPercent}" Maximum="100" Height="8" Margin="0,0,0,12"
                                                 Visibility="{Binding IsSolutionPublishing, Converter={StaticResource BoolToVis}}" />
                                    <DataGrid ItemsSource="{Binding SolutionPublishRows}"
                                              RowHeight="40"
                                              MinHeight="160"
                                              MaxHeight="300"
                                              VirtualizingPanel.IsVirtualizing="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ProjectName}" Width="*" />
                                            <DataGridTextColumn Header="Step" Binding="{Binding CurrentStep}" Width="140" />
                                            <DataGridCheckBoxColumn Header="Build" Binding="{Binding BuildSucceeded}" Width="58" />
                                            <DataGridCheckBoxColumn Header="Docker" Binding="{Binding DockerSucceeded}" Width="62" />
                                            <DataGridCheckBoxColumn Header="Package" Binding="{Binding PackageSucceeded}" Width="70" />
                                            <DataGridCheckBoxColumn Header="Validated" Binding="{Binding ValidationSucceeded}" Width="76" />
                                            <DataGridCheckBoxColumn Header="Ready" Binding="{Binding DeploymentReady}" Width="58" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Operator error cards -->
                            <StackPanel Visibility="{Binding HasFailureDetails, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="Publishing Failures" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding OperatorErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:OperatorErrorCard Title="{Binding Title}"
                                                                        Category="{Binding Category}"
                                                                        Subject="{Binding Subject}"
                                                                        SubjectDetail="{Binding SubjectDetail}"
                                                                        Problem="{Binding Problem}"
                                                                        Details="{Binding Details}"
                                                                        RecommendedActions="{Binding RecommendedActions}"
                                                                        AccentBrush="{StaticResource StatusCriticalBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Button Content="← Previous" Command="{Binding PreviousBulkStepCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Bulk step 3: Publishing Readiness -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="BulkStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="3" />
                            </StackPanel.Visibility>
                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Publishing Readiness" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Ready" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkReadyCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Warnings" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkWarningCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatChipStyle}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Blocked" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding BulkBlockedCount}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SolutionPublishStatus}" Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                    <Button Content="Open Summary Log" Command="{Binding OpenSolutionSummaryLogCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,0,0,12">
                                <Button Content="← Previous" Command="{Binding PreviousBulkStepCommand}" />
                                <Button Content="Continue to Release Library →"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ContinueBulkStepCommand}"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Bulk step 4: Release Library -->
                        <StackPanel>
                            <StackPanel.Visibility>
                                <Binding Path="BulkStep" Converter="{StaticResource StepVisibilityConverter}" ConverterParameter="4" />
                            </StackPanel.Visibility>
                            <Border Style="{StaticResource StepSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Release Library" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                                    <TextBlock Text="Manifest" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding SolutionDeploymentManifestPath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                    <TextBlock Text="Demo Bundle" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding DemoDeploymentBundlePath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                    <TextBlock Text="Release Library" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding ReleaseLibraryPath}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open Release Library"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding OpenReleaseLibraryFolderCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Open Deployments" Command="{Binding OpenReleaseCenterCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Button Content="← Previous" Command="{Binding PreviousBulkStepCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- RIGHT: summary & insights -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Publishing Summary" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Discovered Projects" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Projects.Count}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Last Analysis" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastAnalysisDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Last Publish" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastPublishDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Last Release" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding LastReleaseDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Quality Gates" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="(Last Run)" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Not run">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasQualityGates}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding QualityGates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Shortcuts" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                            <Button Style="{StaticResource ShortcutButtonStyle}" Command="{Binding OpenReadinessReportCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconAudit}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open Reports" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButtonStyle}" Command="{Binding OpenValidationLogsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconHistory}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open Logs" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButtonStyle}" Command="{Binding OpenPackagesFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconFolder}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open Packages Folder" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButtonStyle}" Command="{Binding OpenReleaseLibraryFolderCommand}" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource IconLibrary}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Open Release Library" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ BOTTOM: pipeline console ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton IsChecked="{Binding IsConsoleExpanded}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      MinHeight="24">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconChevronRight}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="10"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConsoleExpanded}" Value="True">
                                                    <Setter Property="LayoutTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Pipeline Console" Style="{StaticResource HeadingTextStyle}" FontSize="13.5" />
                            </StackPanel>
                        </ToggleButton>
                        <TextBlock Text="{Binding ProgressLog.Count, StringFormat={}{0} logs}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Text="{Binding ConsoleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="180"
                                 MinHeight="28"
                                 Padding="8,4"
                                 Margin="0,0,8,0"
                                 ToolTip="Search console output" />
                        <ToggleButton Content="Auto-scroll"
                                      IsChecked="{Binding AutoScrollConsole}"
                                      MinHeight="28"
                                      Padding="10,4"
                                      Margin="0,0,8,0" />
                        <Button Content="Clear"
                                Command="{Binding ClearConsoleCommand}"
                                MinHeight="28"
                                Padding="10,4" />
                    </StackPanel>
                </Grid>

                <ListBox ItemsSource="{Binding ConsoleView}"
                         helpers:AutoScrollBehavior.AutoScroll="{Binding AutoScrollConsole}"
                         Background="{StaticResource SurfaceInsetBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Height="150"
                         Margin="0,10,0,0"
                         FontFamily="Consolas"
                         FontSize="11"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsConsoleExpanded, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
