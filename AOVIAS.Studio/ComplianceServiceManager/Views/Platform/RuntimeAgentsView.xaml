<UserControl x:Class="ComplianceServiceManager.Views.Platform.RuntimeAgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
                <controls:SectionHeader Title="Runtime Agents"
                                        Subtitle="{Binding StatusMessage}"
                                        IconGlyph="{StaticResource IconAgents}">
                    <controls:SectionHeader.ActionContent>
                        <Button Content="Refresh" Command="{Binding InitializeCommand}" />
                    </controls:SectionHeader.ActionContent>
                </controls:SectionHeader>
            </Border>

            <UniformGrid Columns="2" Margin="{StaticResource SectionSpacing}">
                <!-- Connected agent -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Connected Agent" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ConnectedAgentStatus}"
                                   Style="{StaticResource MetricValueTextStyle}" />
                        <TextBlock Text="{Binding ConnectedAgentDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Local dev agent -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Local Development Agent" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding LocalAgent.Name, FallbackValue=Runtime Agent project not found in this repository}"
                                   Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="{Binding LocalAgent.HttpUrl}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Start"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding StartLocalAgentCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Stop"
                                    Command="{Binding StopLocalAgentCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Fleet -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="4">
                <DataGrid ItemsSource="{Binding RegisteredAgents}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Environment" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Agent Endpoint" Binding="{Binding RuntimeAgentEndpoint}" Width="2*" />
                        <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeVersion}" Width="*" />
                        <DataGridTextColumn Header="Health" Binding="{Binding HealthStatus}" Width="*" />
                        <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LastHeartbeatUtc}" Width="*" />
                        <DataGridCheckBoxColumn Header="Ready" Binding="{Binding DeploymentReady}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
