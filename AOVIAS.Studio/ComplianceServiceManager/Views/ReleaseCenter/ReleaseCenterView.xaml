<UserControl x:Class="ComplianceServiceManager.Views.ReleaseCenter.ReleaseCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:release="clr-namespace:ComplianceServiceManager.Contracts.Release"
             xmlns:ds="clr-namespace:Aovias.DesignSystem.Enums;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400"
             Loaded="ReleaseCenterView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style x:Key="LibraryCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
            <Setter Property="Effect" Value="{DynamicResource ElevationLow}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="320" />
            <RowDefinition Height="260" MinHeight="200" />
        </Grid.RowDefinitions>

        <!-- Header + Quick Actions + Wizard Progress -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <controls:SectionHeader Title="Release Center"
                                          Subtitle="{Binding StatusMessage}"
                                          IconGlyph="{StaticResource IconDeployments}">
                    <controls:SectionHeader.ActionContent>
                        <WrapPanel>
                            <Button Content="Deployment Command Center"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Command="{Binding OpenDeploymentCommandCenterCommand}"
                                    Margin="0,0,8,8" />
                            <Button Content="Deploy Latest" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding DeployLatestCommand}" Margin="0,0,8,8" />
                            <Button Content="Rollback Last" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding RollbackLastReleaseCommand}" Margin="0,0,8,8" />
                            <Button Content="Runtime" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ViewRuntimeCommand}" Margin="0,0,8,8" />
                            <Button Content="Timeline" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ViewTimelineCommand}" Margin="0,0,8,8" />
                            <Button Content="Console" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                            <Button Content="Refresh Library" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding RefreshLibraryCommand}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </controls:SectionHeader.ActionContent>
                </controls:SectionHeader>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMd}"
                        Padding="12"
                        Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ"
                                   FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="Release Center runs the deployment wizard. For the Sprint 12 " />
                            <Run Text="Deployment Command Center" FontWeight="SemiBold" />
                            <Run Text=" (pipeline, live progress, classified errors), use the sidebar item " />
                            <Run Text="Deployment Command Center" FontWeight="SemiBold" />
                            <Run Text=" or the button above." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <controls:DeploymentStepIndicator Margin="0,16,0,0"
                                                  CurrentStepIndex="{Binding CurrentWizardStep}">
                    <controls:DeploymentStepIndicator.Steps>
                        <x:Array Type="sys:String">
                            <sys:String>Select Runtime</sys:String>
                            <sys:String>Select Release</sys:String>
                            <sys:String>Analyze</sys:String>
                            <sys:String>Review</sys:String>
                            <sys:String>Approve</sys:String>
                            <sys:String>Deploy</sys:String>
                            <sys:String>Verify</sys:String>
                        </x:Array>
                    </controls:DeploymentStepIndicator.Steps>
                </controls:DeploymentStepIndicator>
            </StackPanel>
        </Border>

        <!-- Main tri-pane: Library | Wizard | Details -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Release Library -->
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Release Library" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Tag="Search releases…" />
                    <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding LibrarySortOptions}" SelectedItem="{Binding LibrarySortMode}" Margin="0,0,0,8" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding FilterService, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" Tag="Filter service" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding FilterEnvironment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" Tag="Filter environment" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding FilterPackageType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Tag="Filter package type (.aovpkg / .aovdeploy)" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredLibraryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type release:ReleaseLibraryItem}">
                                    <Border Style="{DynamicResource LibraryCardBorder}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectLibraryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="v" /><Run Text="{Binding PackageVersion}" FontWeight="SemiBold" />
                                                <Run Text=" · " /><Run Text="{Binding PackageSize}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding BuildNumber, StringFormat='Build {0}'}" Style="{DynamicResource CaptionTextStyle}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding ReleaseDate}" Style="{DynamicResource CaptionTextStyle}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <controls:StatusBadge Text="{Binding Status}" StatusKind="{x:Static ds:StatusKind.Information}" Margin="0,0,6,4" />
                                                <controls:StatusBadge Text="{Binding PackageType}" StatusKind="{x:Static ds:StatusKind.Neutral}" Margin="0,0,6,4" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Analyze" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4"
                                                        Command="{Binding DataContext.AnalyzeReleaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Margin="0,0,6,0" />
                                                <Button Content="Details" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4"
                                                        Command="{Binding DataContext.OpenReleaseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Deployment Wizard -->
            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="18" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Deployment Wizard" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <controls:StatusBadge Text="{Binding SignalRStatus}" StatusKind="{x:Static ds:StatusKind.Healthy}" Margin="12,0,0,0" />
                        <controls:StatusBadge Text="{Binding RollbackStatus}" StatusKind="{x:Static ds:StatusKind.Warning}" Margin="8,0,0,0"
                                              Visibility="{Binding HasRollbackStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Back" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding PreviousWizardStepCommand}" Margin="0,0,8,0" />
                        <Button Content="Next" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding NextWizardStepCommand}" Margin="0,0,8,0" />
                        <Button Content="Analyze" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding AnalyzeReleaseCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsWizardStepAnalyze, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Approve" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ApproveDeploymentCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsWizardStepApprove, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Deploy" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ExecuteDeployCommand}"
                                Visibility="{Binding IsWizardStepDeploy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Step 1: Runtime -->
                            <StackPanel Visibility="{Binding IsWizardStepRuntime, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Select target runtime" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ComboBox ItemsSource="{Binding RuntimeTargetsList}" SelectedItem="{Binding SelectedRuntimeTarget}" MinWidth="240" HorizontalAlignment="Left" />
                                <TextBlock Text="Choose Demo, UAT, Production, or Hospital before selecting a release."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,12,0,0" />
                            </StackPanel>

                            <!-- Step 2: Release -->
                            <StackPanel Visibility="{Binding IsWizardStepRelease, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Select release from library" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedLibraryItem.ServiceName, TargetNullValue=No release selected}" Style="{DynamicResource DetailValue}" />
                                <TextBlock Text="{Binding SelectedLibraryItem.PackageVersion, StringFormat='Version {0}'}" Style="{DynamicResource CaptionTextStyle}" />
                            </StackPanel>

                            <!-- Step 3: Analyze -->
                            <StackPanel Visibility="{Binding IsWizardStepAnalyze, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Analyze package and generate deployment plan" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Validation, compatibility, dependencies, and risk assessment run before any deployment." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Step 4: Review -->
                            <StackPanel Visibility="{Binding IsWizardStepReview, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Review deployment plan" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding DeploymentPlanSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <controls:StatusBadge Grid.Column="1" Text="{Binding Status}" StatusKind="{Binding StatusKind}" Margin="8,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding EstimatedDuration}" Style="{DynamicResource CaptionTextStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,12,0,0" Text="{Binding RiskLevelDisplay, StringFormat='Risk level: {0}'}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EstimatedDowntimeDisplay, StringFormat='Estimated downtime: {0}'}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Step 5: Approve -->
                            <StackPanel Visibility="{Binding IsWizardStepApprove, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Operator approval required" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBox Text="{Binding OperatorNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" Margin="0,0,0,8" Tag="Operator notes (optional)" />
                                <CheckBox Content="I approve this deployment for the selected runtime." IsChecked="{Binding OperatorApproved}" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Step 6: Deploy -->
                            <StackPanel Visibility="{Binding IsWizardStepDeploy, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Deploying release" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding CurrentPipelineStep}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DeploymentProgressSummary}" Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding PipelineSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" />
                                                <controls:StatusBadge Grid.Column="1" Text="{Binding Status}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Step 7: Verify -->
                            <StackPanel Visibility="{Binding IsWizardStepVerify, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Verify deployment health" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" Text="{Binding HealthEndpointDisplay, StringFormat='Health endpoint: {0}'}" />
                                <Button Content="Start Rollback" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding StartRollbackWizardCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                <Button Content="Execute Rollback" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ExecuteRollbackCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding IsRollbackMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Release Details Panel -->
            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Release Details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Application" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding ApplicationDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Service" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding ServiceDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Version" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding VersionDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Framework" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding FrameworkDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Build" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding BuildDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Package Size" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding PackageSizeDisplay}" Style="{DynamicResource DetailValue}" />

                        <TextBlock Text="Database" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <TextBlock Text="Current" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding DatabaseCurrentVersion}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Target" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding DatabaseTargetVersion}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Migrations" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding MigrationCountDisplay}" Style="{DynamicResource DetailValue}" />
                        <TextBlock Text="Rollback" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding RollbackSupportDisplay}" Style="{DynamicResource DetailValue}" />

                        <TextBlock Text="Health" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <TextBlock Text="Endpoint" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Text="{Binding HealthEndpointDisplay}" Style="{DynamicResource DetailValue}" TextWrapping="Wrap" />
                        <TextBlock Text="Timeout / Retries" Style="{DynamicResource DetailLabel}" />
                        <TextBlock Style="{DynamicResource DetailValue}">
                            <Run Text="{Binding HealthTimeoutDisplay, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding HealthRetriesDisplay, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Text="Risk &amp; Estimates" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <TextBlock Text="{Binding RiskLevelDisplay, StringFormat='Risk: {0}'}" />
                        <TextBlock Text="{Binding EstimatedDowntimeDisplay, StringFormat='Downtime: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding EstimatedDeploymentTimeDisplay, StringFormat='Deploy time: {0}'}" Margin="0,4,0,0" />

                        <Button Content="Full Inspection" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding OpenReleaseDetailsCommand}" Margin="0,16,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom: Live Console + History -->
        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,12,0,0">
            <TabControl SelectedIndex="{Binding SelectedBottomTabIndex}">
                <TabItem Header="Live Deployment Console">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,8,8,0">
                            <ItemsControl ItemsSource="{Binding LiveTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,0,0,4"
                                                Background="{DynamicResource SurfaceInsetBrush}"
                                                CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp}" FontWeight="Bold" Width="48" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Width="140" Margin="8,0" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Column="1" Margin="8,8,0,0">
                            <TextBlock Text="{Binding CurrentPipelineStep}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding DeploymentProgressSummary}" Margin="0,4,0,12" />
                            <controls:ProgressRing Value="50" Label="Deploying"
                                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Deployment History">
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="220" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search history" Margin="0,0,8,0" />
                            <Button Content="Export" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding ExportHistoryCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding FilteredHistory}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Release" Binding="{Binding ReleaseId}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding PackageVersion}" Width="80" />
                                <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="80" />
                                <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="90" />
                                <DataGridTextColumn Header="Started" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90" />
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                <DataGridTemplateColumn Header="Actions" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Re-deploy" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,2"
                                                        Command="{Binding DataContext.RedeployFromHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,4,0" />
                                                <Button Content="Rollback" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,2"
                                                        Command="{Binding DataContext.StartRollbackWizardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Release Details Dialog Overlay -->
        <Border Grid.RowSpan="3"
                Background="#AA000000"
                Visibility="{Binding IsReleaseDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{DynamicResource CardBorderStyle}"
                    Width="820"
                    MaxHeight="720"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Release Inspection" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Close" Style="{DynamicResource SecondaryButtonStyle}" Command="{Binding CloseReleaseDetailsCommand}" Margin="16,0,0,0" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                    </StackPanel>
                    <TabControl SelectedIndex="{Binding SelectedDetailsTabIndex}">
                        <TabItem Header="Overview">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding ManifestSummary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding OperatorNotesDisplay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Manifest">
                            <TextBlock Text="{Binding ManifestSummary}" Margin="8" TextWrapping="Wrap" />
                        </TabItem>
                        <TabItem Header="Dependencies">
                            <ListBox ItemsSource="{Binding DependencyLines}" Margin="8" />
                        </TabItem>
                        <TabItem Header="Database">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding DatabaseCurrentVersion, StringFormat='Current: {0}'}" />
                                <TextBlock Text="{Binding DatabaseTargetVersion, StringFormat='Target: {0}'}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MigrationCountDisplay, StringFormat='Migrations: {0}'}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding RollbackSupportDisplay, StringFormat='Rollback: {0}'}" Margin="0,4,0,0" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Configuration">
                            <ListBox ItemsSource="{Binding ConfigurationLines}" Margin="8" />
                        </TabItem>
                        <TabItem Header="Infrastructure">
                            <ListBox ItemsSource="{Binding InfrastructureLines}" Margin="8" />
                        </TabItem>
                        <TabItem Header="Checksums">
                            <ListBox ItemsSource="{Binding ChecksumLines}" Margin="8" FontFamily="Consolas" />
                        </TabItem>
                        <TabItem Header="Release Notes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                                <TextBlock Text="{Binding ReleaseNotesDisplay}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Audit">
                            <DataGrid ItemsSource="{Binding FilteredHistory}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100" />
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
