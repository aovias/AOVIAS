<UserControl x:Class="ComplianceServiceManager.Views.Operations.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
            <controls:SectionHeader Title="Alerts"
                                    Subtitle="Warnings and errors from every workspace in this session."
                                    IconGlyph="{StaticResource IconAlerts}">
                <controls:SectionHeader.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 ToolTip="Search alerts" />
                        <ToggleButton Content="Warnings"
                                      IsChecked="{Binding ShowWarnings}"
                                      Margin="0,0,8,0" />
                        <ToggleButton Content="Errors"
                                      IsChecked="{Binding ShowErrors}" />
                    </StackPanel>
                </controls:SectionHeader.ActionContent>
            </controls:SectionHeader>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4">
            <DataGrid ItemsSource="{Binding AlertsView}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding DisplayTime}" Width="90" />
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="100" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="180" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
