<UserControl x:Class="ComplianceServiceManager.Views.Operations.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
            <controls:SectionHeader Title="Audit"
                                    Subtitle="{Binding StatusMessage}"
                                    IconGlyph="{StaticResource IconAudit}">
                <controls:SectionHeader.ActionContent>
                    <Button Content="Refresh" Command="{Binding InitializeCommand}" />
                </controls:SectionHeader.ActionContent>
            </controls:SectionHeader>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Platform Operations"
                               Style="{StaticResource HeadingTextStyle}"
                               Margin="14,10,0,6" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DeploymentAudit}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=g}" Width="*" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*" />
                            <DataGridTextColumn Header="Operation" Binding="{Binding State}" Width="*" />
                            <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="2*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding PackageVersion}" Width="*" />
                            <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="*" />
                            <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Local Repair Activity"
                               Style="{StaticResource HeadingTextStyle}"
                               Margin="14,10,0,6" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RepairAudit}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=g}" Width="*" />
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                            <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="*" />
                            <DataGridCheckBoxColumn Header="Success" Binding="{Binding Success}" Width="80" />
                            <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
