    <Project Path="Aovias.Runtime.Agent/src/Aovias.Runtime.Agent.Infrastructure/Aovias.Runtime.Agent.Infrastructure.csproj" />
    <Project Path="Aovias.Runtime.Agent/src/Aovias.Runtime.Contracts/Aovias.Runtime.Contracts.csproj" />
    <Project Path="Aovias.Runtime.Agent/src/Aovias.Runtime.SDK/Aovias.Runtime.SDK.csproj" />
