  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aovias.DesignSystem\Aovias.DesignSystem.csproj" />
    <ProjectReference Include="..\Aovias.Configuration\Aovias.Configuration.csproj" />
    <ProjectReference Include="..\Aovias.Orchestration\src\Aovias.Orchestration.Contracts\Aovias.Orchestration.Contracts.csproj" />
    <ProjectReference Include="..\Aovias.Release\src\Aovias.PackageBuilder\Aovias.PackageBuilder.csproj" />
