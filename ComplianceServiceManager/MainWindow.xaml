<Window x:Class="ComplianceServiceManager.MainWindow"
        x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:ComplianceServiceManager.Helpers"
        xmlns:shellVm="clr-namespace:ComplianceServiceManager.ViewModels.Shell"
        xmlns:aiViews="clr-namespace:ComplianceServiceManager.Views.AiCopilot"
        xmlns:aiVm="clr-namespace:ComplianceServiceManager.ViewModels.AiCopilot"
        xmlns:appViews="clr-namespace:ComplianceServiceManager.Views.Applications"
        xmlns:appVm="clr-namespace:ComplianceServiceManager.ViewModels.Applications"
        xmlns:deploymentViews="clr-namespace:ComplianceServiceManager.Views.Deployment"
        xmlns:deploymentVm="clr-namespace:ComplianceServiceManager.ViewModels.Deployment"
        xmlns:devViews="clr-namespace:ComplianceServiceManager.Views.Development"
        xmlns:devVm="clr-namespace:ComplianceServiceManager.ViewModels.Development"
        xmlns:infraViews="clr-namespace:ComplianceServiceManager.Views.Infrastructure"
        xmlns:infraVm="clr-namespace:ComplianceServiceManager.ViewModels.Infrastructure"
        xmlns:observabilityViews="clr-namespace:ComplianceServiceManager.Views.Observability"
        xmlns:observabilityVm="clr-namespace:ComplianceServiceManager.ViewModels.Observability"
        xmlns:opsViews="clr-namespace:ComplianceServiceManager.Views.Operations"
        xmlns:opsVm="clr-namespace:ComplianceServiceManager.ViewModels.Operations"
        xmlns:overviewViews="clr-namespace:ComplianceServiceManager.Views.Overview"
        xmlns:overviewVm="clr-namespace:ComplianceServiceManager.ViewModels.Overview"
        xmlns:platformViews="clr-namespace:ComplianceServiceManager.Views.Platform"
        xmlns:platformVm="clr-namespace:ComplianceServiceManager.ViewModels.Platform"
        xmlns:publishingViews="clr-namespace:ComplianceServiceManager.Views.Publishing"
        xmlns:publishingVm="clr-namespace:ComplianceServiceManager.ViewModels.Publishing"
        xmlns:releasesViews="clr-namespace:ComplianceServiceManager.Views.Releases"
        xmlns:releasesVm="clr-namespace:ComplianceServiceManager.ViewModels.Releases"
        xmlns:runtimeViews="clr-namespace:ComplianceServiceManager.Views.Runtime"
        xmlns:runtimeVm="clr-namespace:ComplianceServiceManager.ViewModels.Runtime"
        xmlns:settingsViews="clr-namespace:ComplianceServiceManager.Views.Settings"
        xmlns:settingsVm="clr-namespace:ComplianceServiceManager.ViewModels.Settings"
        mc:Ignorable="d"
        Title="AOVIAS Studio"
        Icon="Assets/AppIcon.ico"
        Height="920"
        Width="1520"
        MinHeight="720"
        MinWidth="1240">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:ResourceKeyToValueConverter x:Key="ResourceKeyToValueConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceInsetBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="18,20,18,8">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="A"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AOVIAS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="STUDIO"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                        <Border Background="{StaticResource SurfaceInsetBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="7,1"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0">
                            <TextBlock Text="{Binding AppVersionDisplay, StringFormat=v{0}}"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Connected runtime -->
                <Border DockPanel.Dock="Bottom"
                        Margin="16,10,16,14"
                        Padding="13,10"
                        CornerRadius="{StaticResource RadiusMd}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CONNECTED TO"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgentConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontSize="10" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Offline" />
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgentConnected}" Value="True">
                                                    <Setter Property="Text" Value="Online" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ConnectedAgentDisplay}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11.5"
                                   Margin="0,5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="12,4,12,0">
                    <ItemsControl ItemsSource="{Binding NavigationSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type shellVm:NavigationSectionViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource NavSectionLabelStyle}"
                                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type shellVm:NavigationItemViewModel}">
                                                <Button Command="{Binding NavigateCommand}"
                                                        Margin="0,1,0,1"
                                                        MinHeight="38"
                                                        Padding="12,8">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Tag" Value="Selected" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconKey, Converter={StaticResource ResourceKeyToValueConverter}}"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="15"
                                                                   Margin="0,0,11,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12.5"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Badge}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource StatusAiBrush}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Workspace column: command bar / content / status bar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top command bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceInsetBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentWorkspaceTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding CurrentWorkspaceSubtitle}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Platform Status"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgentConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AgentConnectionStatus}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Environment"
                                       FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ActiveProfileDisplay}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Command="{Binding RefreshCurrentWorkspaceCommand}"
                                Width="36"
                                MinHeight="34"
                                Padding="0"
                                Margin="0,0,8,0"
                                ToolTip="Refresh workspace">
                            <TextBlock Text="{StaticResource IconRefresh}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                        <Button Command="{Binding OpenAlertsCommand}"
                                Width="36"
                                MinHeight="34"
                                Padding="0"
                                Margin="0,0,10,0"
                                ToolTip="Alerts &amp; events">
                            <TextBlock Text="{StaticResource IconAlerts}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13" />
                        </Button>
                        <Button Content="Connect"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConnectCommand}"
                                Padding="18,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace host -->
            <ContentControl Grid.Row="1"
                            Margin="{StaticResource PagePadding}"
                            Content="{Binding CurrentWorkspaceViewModel}">
                <ContentControl.Resources>
                <DataTemplate DataType="{x:Type overviewVm:OverviewViewModel}">
                    <overviewViews:OverviewView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type platformVm:EnvironmentsViewModel}">
                    <platformViews:EnvironmentsView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type platformVm:BootstrapViewModel}">
                    <platformViews:BootstrapView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type platformVm:RuntimeAgentsViewModel}">
                    <platformViews:RuntimeAgentsView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type infraVm:InfrastructureViewModel}">
                    <infraViews:InfrastructureView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type platformVm:CertificatesViewModel}">
                    <platformViews:CertificatesView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type releasesVm:ReleasesViewModel}">
                    <releasesViews:ReleasesView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type publishingVm:PublishingViewModel}">
                    <publishingViews:PublishingView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type appVm:DeploymentsWorkspaceViewModel}">
                    <appViews:DeploymentsWorkspaceView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type deploymentVm:PlatformDeploymentCenterViewModel}">
                    <deploymentViews:DeploymentMonitorView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type appVm:RollbackHistoryViewModel}">
                    <appViews:RollbackHistoryView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type runtimeVm:RuntimeDashboardViewModel}">
                    <runtimeViews:RuntimeDashboardView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type opsVm:LiveOperationsViewModel}">
                    <opsViews:LiveOperationsView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type observabilityVm:ObservabilityViewModel}">
                    <observabilityViews:ObservabilityView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type opsVm:ReconciliationViewModel}">
                    <opsViews:ReconciliationView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type opsVm:AlertsViewModel}">
                    <opsViews:AlertsView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type opsVm:AuditViewModel}">
                    <opsViews:AuditView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type devVm:LocalDevServicesViewModel}">
                    <devViews:LocalDevServicesView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type aiVm:AiCopilotViewModel}">
                    <aiViews:AiCopilotView DataContext="{Binding}" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type settingsVm:SettingsConfigurationViewModel}">
                    <settingsViews:SettingsConfigurationView DataContext="{Binding}" />
                </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- Bottom status bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceInsetBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,7">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Platform:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="AOVIAS" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="Version:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="Environment:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ActiveProfileDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="User:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="Time:" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ClockDisplay}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersionDisplay, StringFormat=Build: {0}.0}"
                               FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
