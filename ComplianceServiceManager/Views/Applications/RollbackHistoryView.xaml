<UserControl x:Class="ComplianceServiceManager.Views.Applications.RollbackHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
            <controls:SectionHeader Title="Rollback &amp; History"
                                    Subtitle="{Binding StatusMessage}"
                                    IconGlyph="{StaticResource IconHistory}">
                <controls:SectionHeader.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh"
                                Command="{Binding InitializeCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Roll Back Selected"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RollbackSelectedCommand}" />
                    </StackPanel>
                </controls:SectionHeader.ActionContent>
            </controls:SectionHeader>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4">
            <DataGrid ItemsSource="{Binding History}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=g}" Width="*" />
                    <DataGridTextColumn Header="Package" Binding="{Binding PackageId}" Width="2*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding PackageVersion}" Width="*" />
                    <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="*" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
                    <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="*" />
                    <DataGridCheckBoxColumn Header="Rollback" Binding="{Binding WasRollback}" Width="80" />
                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
