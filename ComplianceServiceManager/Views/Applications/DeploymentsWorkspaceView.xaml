<UserControl x:Class="ComplianceServiceManager.Views.Applications.DeploymentsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:appVm="clr-namespace:ComplianceServiceManager.ViewModels.Applications"
             xmlns:deployment="clr-namespace:ComplianceServiceManager.ViewModels.Deployment"
             xmlns:helpers="clr-namespace:ComplianceServiceManager.Helpers"
             xmlns:dsConverters="clr-namespace:Aovias.DesignSystem.Converters;assembly=Aovias.DesignSystem"
             mc:Ignorable="d"
             d:DesignHeight="1000"
             d:DesignWidth="1500"
             Loaded="DeploymentsWorkspaceView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <helpers:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <dsConverters:StringNotEmptyToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LargeSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FlowSection" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: Deployment + selected runtime / release -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="20,16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Deployment" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="One guided workflow for single-service and multi-service deployments"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,16,0">
                    <TextBlock Text="Target Runtime" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding HeaderRuntimeDisplay}" Style="{StaticResource FieldValue}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Selected Release" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding HeaderReleaseDisplay}" Style="{StaticResource FieldValue}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Always-visible workflow stepper -->
        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="16,12" Margin="0,0,0,14">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type appVm:DeployWorkflowStepItem}">
                        <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0,0,28,0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="30" Height="30" CornerRadius="15">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="{Binding Number}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="✔"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Flow + Deployment Summary -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          x:Name="FlowScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,14,0">
                <StackPanel>

                    <!-- Step 1 — Target Runtime -->
                    <Border x:Name="RuntimeSection" Style="{StaticResource FlowSection}">
                        <StackPanel>
                            <TextBlock Text="Target Runtime" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,28,0">
                                    <TextBlock Text="Environment" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Center.Environments}"
                                              SelectedItem="{Binding Center.SelectedEnvironment}"
                                              DisplayMemberPath="Name"
                                              MinHeight="40" />
                                    <Button Content="Refresh Runtimes"
                                            Style="{StaticResource ToolbarButton}"
                                            Command="{Binding Center.RefreshEnvironmentsCommand}"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                                <UniformGrid Grid.Column="1" Columns="3" Rows="3">
                                    <StackPanel Margin="0,0,18,16">
                                        <TextBlock Text="Runtime Status" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.RuntimeConnectionStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,16">
                                        <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.PlatformVersion, TargetNullValue=—, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Connected" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding ConnectedDisplay}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,16">
                                        <TextBlock Text="Agent Version" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.AgentVersion}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,16">
                                        <TextBlock Text="Docker" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.DockerStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Operating System" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.OperatingSystem}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Deployment API" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.DeploymentApiStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="Configuration" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.ConfigurationStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Live Channel" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding Center.SignalRStatus}" Style="{StaticResource FieldValue}" />
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 2 — Release & service selection (one panel: checkbox = deploy that package) -->
                    <Border x:Name="ReleaseSection" Style="{StaticResource FlowSection}">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Select Releases" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" Margin="0,0,0,0" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding DeploymentModeLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Check each release package to include that service in the deployment. One package = single-service; several = multi-service."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,14" />
                            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                <Button Content="Select All"
                                        Style="{StaticResource ToolbarButton}"
                                        Command="{Binding SelectAllReleasesCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Clear"
                                        Style="{StaticResource ToolbarButton}"
                                        Command="{Binding ClearReleaseSelectionCommand}"
                                        Margin="0,0,12,0" />
                                <TextBox Width="260"
                                         MinHeight="36"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Center.CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by service or version"
                                         Margin="0,0,10,0" />
                                <ComboBox Width="160"
                                          MinHeight="36"
                                          ItemsSource="{Binding Center.CatalogFilters}"
                                          SelectedItem="{Binding Center.CatalogFilter}"
                                          Margin="0,0,10,0"
                                          ToolTip="Latest · Production · Development · Selected" />
                                <Button Content="Refresh Library"
                                        Style="{StaticResource ToolbarButton}"
                                        Command="{Binding Center.RefreshCatalogCommand}"
                                        Margin="0,0,14,0" />
                                <TextBlock Text="{Binding SelectionSummary}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                            </DockPanel>
                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    Background="{DynamicResource SurfaceInsetBrush}">
                                <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Center.FilteredCatalogCards}" Margin="8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type deployment:DeploymentCatalogCardItem}">
                                                <Border Width="300"
                                                        MinHeight="168"
                                                        Padding="14"
                                                        Margin="0,0,12,12"
                                                        CornerRadius="{DynamicResource RadiusMd}"
                                                        BorderThickness="1"
                                                        Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ToggleReleaseSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}" />
                                                    </Border.InputBindings>
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left"
                                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                  IsHitTestVisible="False"
                                                                  Focusable="False"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,2,12,0" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ServiceId}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                            <TextBlock Margin="0,8,0,0">
                                                                <Run Text="Version " /><Run Text="{Binding PackageVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding PublishedDisplay, StringFormat=Date {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                                            <TextBlock Text="{Binding PublisherDisplay, StringFormat=Publisher {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding TagsDisplay, StringFormat=Tags {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Border Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasServiceSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <UniformGrid Columns="4" Rows="2">
                                        <StackPanel Margin="0,0,16,12">
                                            <TextBlock Text="Version" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.PackageVersion, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,12">
                                            <TextBlock Text="Framework" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.FrameworkDisplay, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,12">
                                            <TextBlock Text="Build" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.BuildDisplay, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Checksum" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.ChecksumDisplay, FallbackValue=—}" Style="{StaticResource FieldValue}" FontFamily="Consolas" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Services Included" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.ServicesIncludedDisplay, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Dependencies" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding Center.SelectedCatalogCard.DependenciesDisplay, FallbackValue=—}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Estimated time" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding EstimatedTimeDisplay}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Estimated downtime" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding EstimatedDowntimeDisplay}" Style="{StaticResource FieldValue}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding RestartRequiredDisplay, StringFormat=Restart required — {0}}"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Step 3 — Deployment Plan -->
                    <Border x:Name="PlanSection" Style="{StaticResource FlowSection}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Deployment Plan" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" Margin="0,0,0,0" />
                                <Button DockPanel.Dock="Right"
                                        Content="Validate"
                                        Style="{StaticResource ToolbarButton}"
                                        MinWidth="120"
                                        Command="{Binding Center.AnalyzeSelectedCommand}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PlanChecks}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type appVm:DeployPlanCheckItem}">
                                        <Border Margin="0,0,0,10" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding StatusGlyph}" Width="28" FontSize="14" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="28,4,0,0"
                                                           Visibility="{Binding Detail, Converter={StaticResource StringToVisibilityConverter}}" />
                                                <StackPanel Margin="28,6,0,0" Visibility="{Binding IsFailure, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Impact, StringFormat=Impact — {0}}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Recovery, StringFormat=Recovery — {0}}"
                                                               TextWrapping="Wrap"
                                                               FontWeight="SemiBold"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding BlockerSummary}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Blockers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type appVm:DeployBlockerItem}">
                                                <Border Margin="0,0,0,10"
                                                        Padding="12"
                                                        Background="{DynamicResource SurfaceInsetBrush}"
                                                        CornerRadius="8">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Category, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding Problem, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="Problem" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                        <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                                        <TextBlock Text="Recovery" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                                        <TextBlock Text="{Binding Recovery}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        <TextBlock Text="Fix Command" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                                                                   Visibility="{Binding FixCommand, Converter={StaticResource StringToVisibilityConverter}}" />
                                                        <Border Background="{DynamicResource SurfaceMutedBrush}"
                                                                CornerRadius="6"
                                                                Padding="10,8"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding FixCommand, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding FixCommand}" FontFamily="Consolas" />
                                                        </Border>
                                                        <TextBlock Text="Technical Details" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"
                                                                   Visibility="{Binding TechnicalDetails, Converter={StaticResource StringToVisibilityConverter}}" />
                                                        <TextBlock Text="{Binding TechnicalDetails}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding TechnicalDetails, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Step 5/6 — Deployment Progress -->
                    <Border x:Name="ProgressSection" Style="{StaticResource FlowSection}">
                        <StackPanel>
                            <TextBlock Text="Deployment Progress" Style="{StaticResource SectionTitle}" />
                            <DockPanel Margin="0,0,0,14" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Center.OverallProgressPercent, StringFormat={}{0}%}"
                                           FontWeight="SemiBold"
                                           Width="52"
                                           VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding Center.ElapsedTimeDisplay, StringFormat=Elapsed {0}}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding Center.RemainingTimeDisplay, StringFormat=Remaining {0}}" />
                                </TextBlock>
                                <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Center.OverallProgressPercent}" />
                            </DockPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Center.PhaseTimeline}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type deployment:DeploymentPhaseTimelineItem}">
                                            <Border Width="128"
                                                    MinHeight="118"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StatusGlyph}" FontSize="18" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding StartDisplay, StringFormat=Start {0}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding EndDisplay, StringFormat=End {0}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding DurationDisplay, StringFormat=Duration {0}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding RetriesDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Center.ServiceProgressCards}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type deployment:ServiceProgressCardItem}">
                                        <Border Width="300"
                                                MinHeight="96"
                                                Padding="14"
                                                Margin="0,0,12,12"
                                                Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Phase}" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <ProgressBar Margin="0,10,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding HealthStatus, StringFormat=Health {0}}" Margin="0,0,14,0" FontSize="11" />
                                                    <TextBlock Text="{Binding DurationDisplay, StringFormat=Duration {0}}" FontSize="11" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Deployment Console -->
                    <Border x:Name="ConsoleSection" Style="{StaticResource FlowSection}">
                        <StackPanel>
                            <TextBlock Text="Logs" Style="{StaticResource SectionTitle}" />
                            <TabControl SelectedIndex="{Binding SelectedConsoleTab}" MinHeight="280">
                                <TabItem Header="Summary">
                                    <StackPanel Margin="14">
                                        <TextBlock Text="{Binding Center.StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Center.DeploymentProgressSummary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding Center.CurrentPhase, StringFormat=Current phase — {0}}" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding Center.RollbackStatus}"
                                                   Margin="0,10,0,0"
                                                   Visibility="{Binding Center.HasRollbackStatus, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Live Logs">
                                    <DockPanel Margin="0,10,0,0">
                                        <DockPanel DockPanel.Dock="Top" Margin="14,0,14,10" LastChildFill="False">
                                            <ComboBox Width="130"
                                                      MinHeight="34"
                                                      ItemsSource="{Binding ConsoleLevelFilters}"
                                                      SelectedItem="{Binding ConsoleLevelFilter}"
                                                      Margin="0,0,10,0" />
                                            <TextBox Width="260"
                                                     MinHeight="34"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding ConsoleSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="14,0,14,10"
                                                Background="{DynamicResource SurfaceInsetBrush}">
                                            <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                                <ItemsControl ItemsSource="{Binding FilteredConsoleEntries}" Margin="10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type deployment:DeploymentConsoleEntry}">
                                                            <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" />
                                                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" />
                                                                    <TextBlock Text="{Binding RecoveryAction, StringFormat=Recovery — {0}}"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Events">
                                    <ListBox ItemsSource="{Binding Center.SelectedPhaseLogs}" Margin="14" BorderThickness="0" Background="Transparent" />
                                </TabItem>
                                <TabItem Header="History">
                                    <ListBox ItemsSource="{Binding Center.GroupedHistory}" DisplayMemberPath="Summary" Margin="14" BorderThickness="0" Background="Transparent" />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right sidebar — Deployment Summary -->
            <Border Grid.Column="1"
                    Style="{DynamicResource CardBorderStyle}"
                    Padding="20"
                    Margin="4,0,0,0"
                    VerticalAlignment="Stretch">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Button Content="Review"
                                Style="{StaticResource LargeSecondaryButton}"
                                Command="{Binding ReviewCommand}"
                                Margin="0,0,0,10" />
                        <Button Content="{Binding DeployButtonLabel}"
                                Style="{StaticResource LargePrimaryButton}"
                                Command="{Binding DeploySelectedCommand}"
                                IsEnabled="{Binding CanDeploy}"
                                Margin="0,0,0,10" />
                        <Button Content="Validate"
                                Style="{StaticResource LargeSecondaryButton}"
                                Command="{Binding Center.AnalyzeSelectedCommand}"
                                Margin="0,0,0,10" />
                        <Button Content="Rollback"
                                Style="{StaticResource LargeSecondaryButton}"
                                Command="{Binding Center.RollbackPlatformCommand}"
                                Margin="0,0,0,10" />
                        <Button Content="Cancel"
                                Style="{StaticResource LargeSecondaryButton}"
                                Command="{Binding CancelWorkflowCommand}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Deployment Summary" Style="{StaticResource SectionTitle}" />
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Runtime" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding HeaderRuntimeDisplay}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Release" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding HeaderReleaseDisplay}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Deployment Mode" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding DeploymentModeLabel}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Services Selected" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Dependencies" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding RequiredDependenciesDisplay}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Packages" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SelectedServiceCount}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Estimated Time" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding EstimatedTimeDisplay}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Rollback Available" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding RollbackAvailability}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Approval Status" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding ApprovalStatus}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
