<Window x:Class="ComplianceServiceManager.Views.Development.RuntimeProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Runtime Profile"
        Width="720"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Name" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" MinHeight="32" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Description" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="DescriptionBox" MinHeight="56" TextWrapping="Wrap" AcceptsReturn="True" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Max parallel starts"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBox x:Name="MaxParallelBox" Width="60" MinHeight="28" />
            <TextBlock Text="Depends-on: comma-separated service names within this profile."
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />
        </StackPanel>

        <DataGrid x:Name="ServicesGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  Margin="0,0,0,16">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Depends on" Binding="{Binding DependsOnText, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
