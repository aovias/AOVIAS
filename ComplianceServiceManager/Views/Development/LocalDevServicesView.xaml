<UserControl x:Class="ComplianceServiceManager.Views.Development.LocalDevServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:helpers="clr-namespace:ComplianceServiceManager.Helpers"
             xmlns:models="clr-namespace:ComplianceServiceManager.Models.Workspaces"
             xmlns:wr="clr-namespace:ComplianceServiceManager.Models.WorkspaceRuntime"
             xmlns:localResources="clr-namespace:ComplianceServiceManager.Models.LocalResources"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <helpers:PercentageToGridLengthConverter x:Key="PercentageToGridLengthConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
            <controls:SectionHeader Title="Local Development"
                                    Subtitle="Workspaces and local development services"
                                    IconGlyph="{StaticResource IconDevServices}">
                <controls:SectionHeader.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Refresh Workspaces"
                                Command="{Binding RefreshWorkspacesCommand}" />
                    </StackPanel>
                </controls:SectionHeader.ActionContent>
            </controls:SectionHeader>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedLocalDevTabIndex, Mode=TwoWay}">

            <!-- 1. Overview -->
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="8">
                        <!-- Compact Workspaces -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Workspaces" Style="{StaticResource HeadingTextStyle}" />
                                    <TextBlock Text="{Binding WorkspaceStatusMessage}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DevelopmentWorkspaceItem}">
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,10,0"
                                                    MinHeight="110">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Unavailable}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Dirty}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Path}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,0,6"
                                                               ToolTip="{Binding Path}" />
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Branch" Width="48" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Branch, TargetNullValue=—}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Grid>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Status" Width="48" VerticalAlignment="Center" />
                                                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Clean}">
                                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Dirty}">
                                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Unavailable}">
                                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding StatusDisplay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Agent" Width="48" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AgentOwnerDisplay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Development Status -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <TextBlock Text="Development Status" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Active Agents" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewActiveAgentCount}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Running Services" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding Services.RunningServicesCount}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Runtime Profile" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewRuntimeProfileDisplay, TargetNullValue=—}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LocalResources.CpuDisplay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Memory" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LocalResources.MemoryDisplay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Disk" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding LocalResources.DiskDisplay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,12,0">
                                        <TextBlock Text="Shared Runtime" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewSharedRuntimeStatus}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,12,0">
                                        <TextBlock Text="Healthy" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewSharedRuntimeHealthy}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Owned / Ports" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding OverviewSharedRuntimeOwned, Mode=OneWay}" />
                                            <Run Text=" owned · " />
                                            <Run Text="{Binding OverviewSharedRuntimePorts, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Margin="0,8,12,0">
                                        <TextBlock Text="Cursor Runtime" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewCursorRuntimeStatus}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding OverviewCursorRuntimeDetail}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="Claude Runtime" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding OverviewClaudeRuntimeStatus}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding OverviewClaudeRuntimeDetail}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Resource Status -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Resource Status" Style="{StaticResource HeadingTextStyle}" />
                                    <Button Content="Use Suggested Profile"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding UseSuggestedProfileCommand}"
                                            IsEnabled="{Binding ResourceIntelligence.HasSuggestedProfile}"
                                            HorizontalAlignment="Right"
                                            ToolTip="Explicit confirmation required. Invokes D2 start only after you confirm." />
                                </Grid>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="Overall Pressure" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.OverallPressureDisplay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Memory" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.MemoryDisplay}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{Binding ResourceIntelligence.PrimaryRecommendationTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding ResourceIntelligence.PrimaryRecommendationExplanation}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}">
                                    <Run Text="Suggested: " />
                                    <Run Text="{Binding ResourceIntelligence.SuggestedProfileName, Mode=OneWay, TargetNullValue=—}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Recent Local PRs -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <TextBlock Text="Recent Local PRs" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding LocalPullRequests}"
                                              MaxHeight="160">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0">
                                                            <Run Text="{Binding SourceBranch, Mode=OneWay}" />
                                                            <Run Text=" → " />
                                                            <Run Text="{Binding TargetBranch, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusDisplay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Git & PR -->
            <TabItem Header="Git &amp; PR">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="8">
                        <!-- Workspaces (D1) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="AOVIAS Development Workspaces" Style="{StaticResource HeadingTextStyle}" />
                                    <TextBlock Text="{Binding WorkspaceStatusMessage}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DevelopmentWorkspaceItem}">
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,0,10,0"
                                                    MinHeight="168">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Unavailable}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Dirty}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,0,0,8" />

                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Path" />
                                                    <TextBlock Text="{Binding Path}"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,0,0,8"
                                                               ToolTip="{Binding Path}" />

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Branch" Width="56" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Branch, TargetNullValue=—}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="HEAD" Width="56" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding HeadDisplay}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Status" Width="56" VerticalAlignment="Center" />
                                                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Clean}">
                                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Dirty}">
                                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Availability}" Value="{x:Static models:WorkspaceAvailability.Unavailable}">
                                                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding StatusDisplay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <TextBlock Text="{Binding StatusReason}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,6"
                                                               Visibility="{Binding StatusReason, Converter={StaticResource NotNullToVis}}" />

                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Role" Width="56" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RoleDisplay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="Agent" Width="56" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AgentOwnerDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <TextBlock Text="Workspace Runtime vs Git" Style="{StaticResource HeadingTextStyle}" />
                                <TextBlock Text="Runtime execution never mutates Git. If the workspace HEAD changes while a runtime is running, Studio shows Source changed — it does not restart automatically."
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <ItemsControl ItemsSource="{Binding WorkspaceRuntimes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type wr:WorkspaceRuntimeItem}">
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10"
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock>
                                                        <Run Text="{Binding WorkspaceDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Branch, Mode=OneWay, TargetNullValue=—}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                                                        <Run Text="Runtime: " />
                                                        <Run Text="{Binding RuntimeCaption, Mode=OneWay, TargetNullValue=—}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SourceChangedDisplay}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,4,0,0"
                                                               Visibility="{Binding SourceChangedDisplay, Converter={StaticResource NotNullToVis}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Local Pull Requests (D3 — local-only, no remote) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Local Pull Requests" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Local Git review lifecycle (no remote). Discover → compare → validate → review → approve → explicit merge."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding PullRequestStatusMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,12,0"
                                                   MaxWidth="280"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshLocalPullRequestsCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Create Local PR"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding CreateLocalPullRequestCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding LocalPullRequests}"
                                             SelectedItem="{Binding SelectedPullRequest, Mode=TwoWay}"
                                             DisplayMemberPath="Title"
                                             MinHeight="120"
                                             MaxHeight="200"
                                             Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedPullRequest.Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding SelectedPullRequest.AuthorAgent, Mode=OneWay}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding SelectedPullRequest.TargetBranch, Mode=OneWay}" />
                                            <Run Text="  (" />
                                            <Run Text="{Binding SelectedPullRequest.SourceBranch, Mode=OneWay}" />
                                            <Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedPullRequest.StatusDisplay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding SelectedPullRequest.SummaryDisplay}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedPullRequest.GitStateDisplay}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding SelectedPullRequest.BlockReason}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding SelectedPullRequest.BlockReason, Converter={StaticResource NotNullToVis}}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0">
                                            <Run Text="Validation: " />
                                            <Run Text="{Binding SelectedPullRequest.ValidationDisplay, Mode=OneWay}" />
                                            <Run Text="  ·  Merge: " />
                                            <Run Text="{Binding SelectedPullRequest.MergeCommitSha, Mode=OneWay, TargetNullValue=—}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding ReviewComment, UpdateSourceTrigger=PropertyChanged}"
                                             MinWidth="220"
                                             Margin="0,0,8,0"
                                             ToolTip="Review comment for approve / request changes" />
                                    <Button Content="Approve"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ApproveSelectedPullRequestCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Request Changes"
                                            Command="{Binding RequestChangesSelectedPullRequestCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Merge"
                                            Command="{Binding MergeSelectedPullRequestCommand}"
                                            IsEnabled="{Binding CanMergeSelectedPullRequest}"
                                            ToolTip="Explicit human merge only. Disabled until APPROVED with matching SHAs and clean worktrees." />
                                </StackPanel>

                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid Grid.Column="0"
                                              ItemsSource="{Binding SelectedPullRequest.Commits}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="140"
                                              Margin="0,0,8,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="SHA" Binding="{Binding ShortSha}" Width="80" />
                                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid Grid.Column="1"
                                              ItemsSource="{Binding SelectedPullRequest.ChangedFiles}"
                                              SelectedValuePath="Path"
                                              SelectedValue="{Binding SelectedPullRequest.SelectedFilePath, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*" />
                                            <DataGridTextColumn Header="St" Binding="{Binding Status}" Width="40" />
                                            <DataGridTextColumn Header="+" Binding="{Binding Additions}" Width="40" />
                                            <DataGridTextColumn Header="-" Binding="{Binding Deletions}" Width="40" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                                <StackPanel Grid.Row="4">
                                    <Button Content="Load Diff"
                                            Command="{Binding LoadSelectedPullRequestDiffCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,6" />
                                    <TextBox Text="{Binding SelectedPullRequest.SelectedDiffText}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             MinHeight="100"
                                             MaxHeight="180" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Agent Sessions -->
            <TabItem Header="Agent Sessions">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="8">
                        <!-- Agent Sessions (D4 — development agents, not Runtime Agent) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Agent Sessions" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Development-agent context (Cursor/Claude): task → workspace → branch → runtime → resources → local PR. Metadata only — no Git/runtime auto-actions."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding AgentSessionStatusMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,12,0"
                                                   MaxWidth="260"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshAgentSessionsCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="New Agent Session"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding CreateAgentSessionCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding AgentSessions}"
                                             SelectedItem="{Binding SelectedAgentSession, Mode=TwoWay}"
                                             DisplayMemberPath="Title"
                                             MinHeight="120"
                                             MaxHeight="200"
                                             Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock>
                                            <Run Text="{Binding SelectedAgentSession.AgentDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SelectedAgentSession.StatusDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SelectedAgentSession.HealthDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedAgentSession.Title}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0">
                                            <Run Text="Task: " />
                                            <Run Text="{Binding SelectedAgentSession.TaskId, Mode=OneWay, TargetNullValue=—}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Workspace: " />
                                            <Run Text="{Binding SelectedAgentSession.WorkspaceDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Branch expected: " />
                                            <Run Text="{Binding SelectedAgentSession.ExpectedBranch, Mode=OneWay}" />
                                            <Run Text="  · actual: " />
                                            <Run Text="{Binding SelectedAgentSession.ActualBranch, Mode=OneWay, TargetNullValue=—}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                                            <Run Text="Runtime: " />
                                            <Run Text="{Binding SelectedAgentSession.RuntimeProfileDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Workspace Runtime: " />
                                            <Run Text="{Binding SelectedAgentSession.RuntimeDisplay, Mode=OneWay, TargetNullValue=—}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="PR: " />
                                            <Run Text="{Binding SelectedAgentSession.PullRequestDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                                            <Run Text="Resources: " />
                                            <Run Text="{Binding SelectedAgentSession.ResourcesDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding SelectedAgentSession.AttentionReasons}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Start" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartSelectedAgentSessionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Pause" Command="{Binding PauseSelectedAgentSessionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Resume" Command="{Binding ResumeSelectedAgentSessionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Complete" Command="{Binding CompleteSelectedAgentSessionCommand}" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Command="{Binding CancelSelectedAgentSessionCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4. Services -->
            <TabItem Header="Services">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="8">
                        <!-- Shared Runtime (V2.3) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Shared Runtime" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Canonical shared execution (AOVIAS). Plan and validate before start. Does not run Cursor or Claude workspace instances."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SharedRuntimeStatusMessage}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               MaxWidth="340"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right" />
                                </Grid>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Profile" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding SharedRuntime.ProfileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Status" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding SharedRuntime.StatusDisplay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Healthy / Owned" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding SharedRuntime.HealthyDisplay, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SharedRuntime.OwnedCount, Mode=OneWay}" />
                                            <Run Text=" owned" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Ports / Resources" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding SharedRuntime.PortsDisplay, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SharedRuntime.ResourceDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Plan"
                                            Command="{Binding PlanSharedRuntimeCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Start"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartSharedRuntimeCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Stop"
                                            Command="{Binding StopSharedRuntimeCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Cancel Startup"
                                            Command="{Binding CancelSharedRuntimeStartupCommand}"
                                            Visibility="{Binding SharedRuntime.CanExecuteCancel, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SharedRuntime.ValidationLines}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DataGrid ItemsSource="{Binding SharedRuntime.PlanRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          MaxHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40" />
                                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                                        <DataGridTextColumn Header="Instance" Binding="{Binding InstanceDisplay}" Width="80" />
                                        <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="70" />
                                        <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="80" />
                                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="110" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Workspace Runtimes (V2.4) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Workspace Runtimes" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Selective isolation for Cursor and Claude. Reuses healthy Shared Runtime dependencies. Does not launch Cursor or Claude. Does not mutate Git."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WorkspaceRuntimeStatusMessage}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               MaxWidth="340"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WorkspaceRuntimes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type wr:WorkspaceRuntimeItem}">
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding WorkspaceDisplay}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding StatusDisplay}"
                                                                   HorizontalAlignment="Right"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryBrush}" />
                                                    </Grid>
                                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="Workspace" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontSize="12" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="Branch" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Text="{Binding Branch, TargetNullValue=—}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="Agent" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Text="{Binding AgentDisplay}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Runtime" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6">
                                                        <Run Text="Services: " />
                                                        <Run Text="{Binding IsolatedCount, Mode=OneWay}" />
                                                        <Run Text=" isolated · " />
                                                        <Run Text="{Binding ReuseSharedCount, Mode=OneWay}" />
                                                        <Run Text=" shared dependencies" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SourceChangedDisplay}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,6"
                                                               Visibility="{Binding SourceChangedDisplay, Converter={StaticResource NotNullToVis}}" />
                                                    <TextBlock Text="Isolate" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,4" />
                                                    <ItemsControl ItemsSource="{Binding IsolationChoices}" Margin="0,0,0,8">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type wr:WorkspaceIsolationChoice}">
                                                                <CheckBox Content="{Binding ServiceName}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Margin="0,0,12,4" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Button Content="Plan"
                                                                Command="{Binding DataContext.PlanWorkspaceRuntimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Start"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Command="{Binding DataContext.StartWorkspaceRuntimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanExecuteStart}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Stop"
                                                                Command="{Binding DataContext.StopWorkspaceRuntimeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanExecuteStop}"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="Cancel Startup"
                                                                Command="{Binding DataContext.CancelWorkspaceRuntimeStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanExecuteCancel, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding ValidationLines}" Margin="0,0,0,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           Style="{StaticResource CaptionTextStyle}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,0,0,2" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <DataGrid ItemsSource="{Binding PlanRows}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              HeadersVisibility="Column"
                                                              CanUserAddRows="False"
                                                              MaxHeight="160">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                                                            <DataGridTextColumn Header="Action" Binding="{Binding ActionDisplay}" Width="130" />
                                                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="90" />
                                                            <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="70" />
                                                            <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="140" />
                                                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Runtime Profiles (D2) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Runtime Profiles" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Preferred way to start local stacks with dependency order. Start All below remains available as a legacy parallel start."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProfileStatusMessage}"
                                               Style="{StaticResource CaptionTextStyle}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               MaxWidth="320"
                                               TextWrapping="Wrap"
                                               TextAlignment="Right" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding RuntimeProfiles}"
                                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                             DisplayMemberPath="Name"
                                             MinHeight="120"
                                             MaxHeight="180"
                                             Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedProfile.Description}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedProfile.StatusDisplay, TargetNullValue=—}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding SelectedProfile.ValidationDisplay}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedProfile.ProgressMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedProfile.ProgressMessage, Converter={StaticResource NotNullToVis}}" />
                                        <ItemsControl ItemsSource="{Binding SelectedProfile.ValidationIssues}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="Validate"
                                            Command="{Binding ValidateSelectedProfileCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Validate All"
                                            Command="{Binding ValidateAllProfilesCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Start Profile"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartSharedRuntimeCommand}"
                                            Margin="0,0,8,0"
                                            ToolTip="Starts via Shared Runtime: Plan → validate → explicit confirm. Does not use legacy Start All." />
                                    <Button Content="Stop Owned"
                                            Command="{Binding StopSharedRuntimeCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Restart"
                                            Command="{Binding RestartSelectedProfileCommand}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Edit…"
                                            Command="{Binding EditSelectedProfileCommand}" />
                                </StackPanel>

                                <Expander Grid.Row="3"
                                          Header="Profile members"
                                          IsExpanded="True"
                                          Visibility="{Binding SelectedProfile, Converter={StaticResource NotNullToVis}}">
                                    <DataGrid ItemsSource="{Binding SelectedProfile.Members}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="160"
                                              Margin="0,8,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*" />
                                            <DataGridCheckBoxColumn Header="Owned" Binding="{Binding OwnedByProfile}" Width="70" IsReadOnly="True" />
                                            <DataGridCheckBoxColumn Header="Reused" Binding="{Binding Reused}" Width="70" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </Grid>
                        </Border>

                        <!-- Solution folders -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Solution Folders" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Add Solution"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding AddSolutionFolderCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Remove Solution"
                                                Command="{Binding RemoveSelectedFolderCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Refresh Discovery"
                                                Command="{Binding RefreshDiscoveryCommand}" />
                                    </StackPanel>
                                </Grid>
                                <ListBox ItemsSource="{Binding SolutionFolders}"
                                         SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="96"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="999"
                                                    Padding="12,5"
                                                    Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{StaticResource IconFolder}"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Services -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discovered Services" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Services.ServiceCount, StringFormat={}{0} services}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Services.RunningServicesCount, StringFormat={}{0} running}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox Text="{Binding Services.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinWidth="180"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Filter services" />
                                        <Button Content="Start All (legacy)"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding Services.StartAllCommand}"
                                                ToolTip="Legacy parallel start of all discovered services. Prefer Runtime Profiles for dependency-aware startup."
                                                Margin="0,0,8,0" />
                                        <Button Content="Stop All"
                                                Command="{Binding Services.StopAllCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Restart All"
                                                Command="{Binding Services.RestartAllCommand}" />
                                    </StackPanel>
                                </Grid>

                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding Services.ServicesView}"
                                              SelectedItem="{Binding SelectedDiscoveredService, Mode=TwoWay}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              RowHeight="48"
                                              MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding DisplayKind}" Width="*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                            <DataGridTextColumn Header="URL" Binding="{Binding DisplayHttpsUrl}" Width="2*" />
                                            <DataGridTextColumn Header="PID" Binding="{Binding DisplayProcessId}" Width="70" />
                                            <DataGridTextColumn Header="Since" Binding="{Binding DisplayRunningSince}" Width="90" />
                                            <DataGridTemplateColumn Header="Actions" Width="230">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Start"
                                                                    Padding="10,3"
                                                                    MinHeight="26"
                                                                    Command="{Binding DataContext.Services.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,6,0" />
                                                            <Button Content="Stop"
                                                                    Padding="10,3"
                                                                    MinHeight="26"
                                                                    Command="{Binding DataContext.Services.StopServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Margin="0,0,6,0" />
                                                            <Button Content="Open"
                                                                    Padding="10,3"
                                                                    MinHeight="26"
                                                                    Command="{Binding DataContext.Services.OpenSwaggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2"
                                            Style="{StaticResource CardBorderStyle}"
                                            Padding="12"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding SelectedDiscoveredService, Converter={StaticResource NotNullToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Service Instances" Style="{StaticResource HeadingTextStyle}" />
                                                    <TextBlock Text="Definition vs execution context. Port numbers come from the Local Port Registry when assigned."
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding ServiceInstanceStatusMessage}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="Assign Port"
                                                            Command="{Binding AssignPortCommand}"
                                                            Margin="0,0,8,0" />
                                                    <Button Content="Refresh Instances"
                                                            Command="{Binding RefreshServiceInstancesCommand}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8">
                                                <Run Text="Definition: " />
                                                <Run Text="{Binding SelectedDiscoveredService.Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding SelectedDiscoveredService.DisplayKind, Mode=OneWay}" />
                                            </TextBlock>
                                            <DataGrid ItemsSource="{Binding SelectedServiceInstances}"
                                                      SelectedItem="{Binding SelectedServiceInstance}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      MaxHeight="180">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="90" />
                                                    <DataGridTextColumn Header="Workspace" Binding="{Binding WorkspaceDisplay}" Width="*" />
                                                    <DataGridTextColumn Header="Branch" Binding="{Binding Branch, TargetNullValue=—}" Width="*" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding StateDisplay}" Width="110" />
                                                    <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="90" />
                                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessIdDisplay}" Width="70" />
                                                    <DataGridTextColumn Header="Config" Binding="{Binding ConfigurationDisplay}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Style="{StaticResource CardBorderStyle}"
                                            Padding="12"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Local Port Registry" Style="{StaticResource HeadingTextStyle}" />
                                                    <TextBlock Text="Configured port ownership for Service Instances. OS occupancy is point-in-time only — never kills or starts processes."
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding PortRegistryStatusMessage}"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="Release Port"
                                                            Command="{Binding ReleasePortCommand}"
                                                            Margin="0,0,8,0" />
                                                    <Button Content="Refresh"
                                                            Command="{Binding RefreshPortRegistryCommand}" />
                                                </StackPanel>
                                            </Grid>
                                            <DataGrid ItemsSource="{Binding PortAllocations}"
                                                      SelectedItem="{Binding SelectedPortAllocation}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      CanUserAddRows="False"
                                                      MaxHeight="200">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70" />
                                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                                                    <DataGridTextColumn Header="Instance" Binding="{Binding InstanceDisplay}" Width="90" />
                                                    <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="90" />
                                                    <DataGridTextColumn Header="Workspace" Binding="{Binding WorkspaceDisplay}" Width="*" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="150" />
                                                    <DataGridTextColumn Header="Occupant" Binding="{Binding OccupantDisplay}" Width="140" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            <!-- 5. Monitoring -->
            <TabItem Header="Monitoring">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="8">
                        <!-- Local Resources (S3 — observation only) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Local Resources" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Developer machine telemetry (CPU / RAM / disk). Distinct from Runtime Agent metrics. Observation only — no automatic profile decisions."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}">
                                            <Run Text="Shared Runtime: " />
                                            <Run Text="{Binding SharedRuntime.StatusDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · Healthy " />
                                            <Run Text="{Binding SharedRuntime.HealthyDisplay, Mode=OneWay}" />
                                            <Run Text=" · CPU " />
                                            <Run Text="{Binding LocalResources.CpuDisplay, Mode=OneWay}" />
                                            <Run Text=" · Memory " />
                                            <Run Text="{Binding LocalResources.MemoryDisplay, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding LocalResources.StatusMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshLocalResourcesCommand}" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Border Background="{StaticResource SurfaceInsetBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding LocalResources.CpuStatus}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock Text="{Binding LocalResources.CpuDisplay}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="0,6,0,8" />
                                            <Border Background="#08111F" CornerRadius="6" Height="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding LocalResources.CpuPercent, Converter={StaticResource PercentageToGridLengthConverter}}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceInsetBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Memory" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding LocalResources.MemoryStatus}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock Text="{Binding LocalResources.MemoryDisplay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,8" />
                                            <Border Background="#08111F" CornerRadius="6" Height="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding LocalResources.MemoryPercent, Converter={StaticResource PercentageToGridLengthConverter}}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource WarningBrush}" CornerRadius="6" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceInsetBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="Disk" Style="{StaticResource CaptionTextStyle}" />
                                                <TextBlock Text="{Binding LocalResources.DiskStatus}"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <TextBlock Text="{Binding LocalResources.DiskRootDisplay}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding LocalResources.DiskDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,8" />
                                            <Border Background="#08111F" CornerRadius="6" Height="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding LocalResources.DiskPercent, Converter={StaticResource PercentageToGridLengthConverter}}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource SuccessBrush}" CornerRadius="6" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{Binding LocalResources.MeasurementNotes}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Running service processes"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding ServiceResourceRows}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          MaxHeight="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="2*" />
                                        <DataGridTextColumn Header="Scope" Binding="{Binding ScopeDisplay}" Width="80" />
                                        <DataGridTextColumn Header="Workspace" Binding="{Binding WorkspaceDisplay}" Width="80" />
                                        <DataGridTextColumn Header="Agent" Binding="{Binding AgentDisplay}" Width="70" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessIdDisplay}" Width="70" />
                                        <DataGridTextColumn Header="Port" Binding="{Binding PortDisplay}" Width="70" />
                                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuDisplay}" Width="80" />
                                        <DataGridTextColumn Header="RAM" Binding="{Binding MemoryDisplay}" Width="100" />
                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Resource Intelligence (D5 — recommend only, no auto mutation) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="{StaticResource SectionSpacing}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Resource Intelligence" Style="{StaticResource HeadingTextStyle}" />
                                        <TextBlock Text="Advisory assessment over S3 telemetry. Observe → analyze → recommend → ask. No automatic profile/process/Git changes."
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding ResourceIntelligenceStatusMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Margin="0,0,12,0"
                                                   MaxWidth="260"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Refresh Assessment"
                                                Command="{Binding RefreshResourceIntelligenceCommand}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Use Suggested Profile"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding UseSuggestedProfileCommand}"
                                                IsEnabled="{Binding ResourceIntelligence.HasSuggestedProfile}"
                                                ToolTip="Explicit confirmation required. Invokes D2 start only after you confirm." />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Overall" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.OverallPressureDisplay}" FontWeight="SemiBold" FontSize="16" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Memory" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.MemoryPressureDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResourceIntelligence.MemoryDisplay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.CpuPressureDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResourceIntelligence.CpuDisplay}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Disk" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{Binding ResourceIntelligence.DiskPressureDisplay}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResourceIntelligence.DiskDisplay}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{Binding ResourceIntelligence.Summary}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="Recommendation" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ResourceIntelligence.PrimaryRecommendationTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding ResourceIntelligence.PrimaryRecommendationExplanation}"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,10" />
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,10">
                                    <Run Text="Suggested: " />
                                    <Run Text="{Binding ResourceIntelligence.SuggestedProfileName, Mode=OneWay, TargetNullValue=—}" />
                                </TextBlock>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DataGrid Grid.Column="0"
                                              ItemsSource="{Binding ResourceIntelligence.ActiveSessions}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="120"
                                              Margin="0,0,8,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Agent" Binding="{Binding AgentDisplay}" Width="80" />
                                            <DataGridTextColumn Header="Session" Binding="{Binding Title}" Width="*" />
                                            <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeProfileDisplay}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid Grid.Column="1"
                                              ItemsSource="{Binding ResourceIntelligence.ProfileEstimates}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              MaxHeight="120">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Profile" Binding="{Binding ProfileName}" Width="*" />
                                            <DataGridTextColumn Header="Svc" Binding="{Binding ExpectedProcessCount}" Width="40" />
                                            <DataGridTextColumn Header="Mem" Binding="{Binding MemoryClass}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
