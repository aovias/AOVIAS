<UserControl x:Class="ComplianceServiceManager.Views.Platform.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
                <controls:SectionHeader Title="Certificates"
                                        Subtitle="Platform certificate conventions and local development HTTPS certificate."
                                        IconGlyph="{StaticResource IconCertificates}" />
            </Border>

            <UniformGrid Columns="2" Margin="{StaticResource SectionSpacing}">
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Development HTTPS Certificate" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding DevCertStatus}" Style="{StaticResource MetricValueTextStyle}" />
                        <TextBlock Text="{Binding DevCertDetail}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Check Certificate"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CheckDevCertificateCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Copy Trust Command"
                                    Command="{Binding CopyTrustCommandCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Platform Conventions" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Conventions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Area}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
