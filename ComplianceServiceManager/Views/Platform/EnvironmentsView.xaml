<UserControl x:Class="ComplianceServiceManager.Views.Platform.EnvironmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Aovias.DesignSystem.Controls;assembly=Aovias.DesignSystem"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="{StaticResource SectionSpacing}">
            <controls:SectionHeader Title="Environments"
                                    Subtitle="{Binding StatusMessage}"
                                    IconGlyph="{StaticResource IconEnvironments}">
                <controls:SectionHeader.ActionContent>
                    <Button Content="Refresh"
                            Command="{Binding InitializeCommand}" />
                </controls:SectionHeader.ActionContent>
            </controls:SectionHeader>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Master: environment list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,0,12,0">
                <DataGrid ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding EnvironmentType}" Width="*" />
                        <DataGridTextColumn Header="Health" Binding="{Binding HealthStatus}" Width="*" />
                        <DataGridTextColumn Header="Platform" Binding="{Binding PlatformVersion}" Width="*" />
                        <DataGridCheckBoxColumn Header="Ready" Binding="{Binding DeploymentReady}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEnvironment.Name, FallbackValue=Select an environment}"
                                       Style="{StaticResource HeadingTextStyle}" />
                            <TextBlock Text="{Binding SelectedEnvironment.BaseUrl}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,4,0,12" />
                            <UniformGrid Columns="2" Rows="3">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Runtime Version" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.RuntimeVersion, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Last Heartbeat" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.LastHeartbeatUtc, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Registered" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.RegisteredUtc, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Admission Blockers" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.AdmissionBlockerCount, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Maintenance" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.MaintenanceMode, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Last Deployment" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedEnvironment.LastDeploymentUtc, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Capabilities" Style="{StaticResource CaptionTextStyle}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding SelectedEnvironment.Capabilities}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceInsetBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="10,3"
                                                Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Host Health" Style="{StaticResource HeadingTextStyle}" />
                                <Button Content="Refresh Health"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshHealthCommand}" />
                            </Grid>
                            <UniformGrid Columns="2" Rows="3">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="CPU" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.CpuUsagePercent, StringFormat={}{0:F1}%, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Memory" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.MemoryUsagePercent, StringFormat={}{0:F1}%, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Disk" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.DiskUsagePercent, StringFormat={}{0:F1}%, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Docker" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.DockerStatus, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Containers Running" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.RunningContainerCount, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Containers Total" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{Binding SelectedHealth.ContainerCount, FallbackValue=-}" Style="{StaticResource BodyTextStyle}" Margin="0,2,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
