<UserControl x:Class="ComplianceServiceManager.Views.Deployment.DeploymentMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:deployment="clr-namespace:ComplianceServiceManager.ViewModels.Deployment"
             mc:Ignorable="d"
             d:DesignHeight="960"
             d:DesignWidth="1500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MonitorSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <!-- Deployment Workspace refactor: the former "Deployment Command Center" is now the
         Deployment MONITOR — observe, retry, roll back, review sessions and history. Deployment
         INITIATION lives exclusively in Applications → Deployments' unified workflow; there is
         deliberately no Deploy/Analyze/package-selection control anywhere on this surface. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- Live session header -->
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Live Session" Style="{StaticResource MonitorSectionTitle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Rollback"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            MinHeight="38"
                            MinWidth="140"
                            FontWeight="SemiBold"
                            Command="{Binding RollbackPlatformCommand}" />
                </DockPanel>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Environment" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SelectedEnvironment.Name, FallbackValue=—}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Current Phase" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CurrentPhase}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Elapsed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ElapsedTimeDisplay}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Certification" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CertificationStatus}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Success Rate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DeploymentSuccessRate}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <DockPanel Margin="0,12,0,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding OverallProgressPercent, StringFormat={}{0}%}"
                               FontWeight="SemiBold"
                               Width="48" />
                    <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding OverallProgressPercent}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Pipeline + service progress + phase timeline -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pipeline" Style="{StaticResource MonitorSectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PipelineStages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type deployment:DeploymentPipelineStageItem}">
                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding StatusGlyph}" DockPanel.Dock="Left" Margin="0,0,8,0" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                            <TextBlock Text="{Binding DurationDisplay, StringFormat=Duration {0}}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Services" Style="{StaticResource MonitorSectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ServiceProgressCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type deployment:ServiceProgressCardItem}">
                                    <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Phase}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <ProgressBar Margin="0,8,0,0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding HealthStatus, StringFormat=Health {0}}" Margin="0,0,12,0" FontSize="11" />
                                                <TextBlock Text="{Binding DurationDisplay, StringFormat=Duration {0}}" FontSize="11" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Phase Timeline" Style="{StaticResource MonitorSectionTitle}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PhaseTimeline}"
                             SelectedItem="{Binding SelectedPhaseTimelineItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type deployment:DeploymentPhaseTimelineItem}">
                                <DockPanel>
                                    <TextBlock Text="{Binding StatusGlyph}" Margin="0,0,8,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Selected Phase Logs" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ListBox Grid.Row="3" ItemsSource="{Binding SelectedPhaseLogs}" FontFamily="Consolas" FontSize="11" />
                </Grid>
            </Border>
        </Grid>

        <!-- Console + history + rollback plan -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Console" Style="{StaticResource MonitorSectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ConsoleEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type deployment:DeploymentConsoleEntry}">
                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource MonitorSectionTitle}" />
                    <ListBox ItemsSource="{Binding GroupedHistory}" DisplayMemberPath="Summary" BorderThickness="0" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Rollback Plan" Style="{StaticResource MonitorSectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RollbackPlanItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type deployment:RollbackPresentationItem}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TargetVersion, StringFormat=Target v{0}}" FontSize="11" />
                                        <TextBlock Text="{Binding RiskLevel, StringFormat=Risk {0}}" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
