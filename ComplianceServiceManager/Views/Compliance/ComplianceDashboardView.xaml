<UserControl x:Class="ComplianceServiceManager.Views.Compliance.ComplianceDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ComplianceServiceManager.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1380">
    <UserControl.Resources>
        <helpers:StatusBrushConverter x:Key="StatusBrushConverter" />
        <helpers:StatusBadgeBackgroundConverter x:Key="StatusBadgeBackgroundConverter" />
        <helpers:HealthBrushConverter x:Key="HealthBrushConverter" />
        <helpers:LogLevelBrushConverter x:Key="LogLevelBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="260" MinHeight="190" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="12"
                            Background="{StaticResource SurfaceInsetBrush}"
                            BorderBrush="{StaticResource StatusComplianceBrush}"
                            BorderThickness="1"
                            Margin="0,0,13,0">
                        <TextBlock Text="{StaticResource IconCompliance}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="18"
                                   Foreground="{StaticResource StatusComplianceBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Compliance"
                                   Style="{StaticResource DisplayTextStyle}"
                                   FontSize="22" />
                        <TextBlock Text="Microservice orchestration and health monitoring"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Width="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="24,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="36,8,12,8"
                             ToolTip="Search services by name, path, or URL" />
                    <TextBlock Text="?"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="16"
                               Margin="13,0,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />
                </Grid>

                <WrapPanel Grid.Column="2"
                           Orientation="Horizontal"
                           VerticalAlignment="Center"
                           ItemHeight="36">
                    <ComboBox Width="136"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding Environments}"
                              SelectedItem="{Binding SelectedEnvironment}" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="StartAllButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=">" Margin="0,0,7,0" />
                            <TextBlock Text="Start All" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Click="StopAllButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="[]" Margin="0,0,7,0" />
                            <TextBlock Text="Stop All" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,0"
                            Click="RestartAllButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="R" Margin="0,0,7,0" />
                            <TextBlock Text="Restart All" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="FixFailedServicesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AI" Margin="0,0,7,0" />
                            <TextBlock Text="Fix Failed" />
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshServicesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Reload" Margin="0,0,7,0" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0"
                         Columns="4"
                         Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Discovered Services" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ServiceCount}" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Running" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RunningServicesCount}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="10,0,5,0">
                    <StackPanel>
                        <TextBlock Text="Needs Attention" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="10" Height="10" Fill="#F97316" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorServicesCount}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="14"
                        Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Failed Repairs" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="10" Height="10" Fill="#F43F5E" Margin="0,0,9,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FailedRepairCount}" FontSize="24" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                <TabItem Header="Services">
            <Border
                    Style="{StaticResource CardBorderStyle}"
                    Padding="1">
                <DataGrid ItemsSource="{Binding ServicesView}"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="1.35*" MinWidth="190" />
                        <DataGridTextColumn Header="Type" Binding="{Binding DisplayKind}" Width="95" MinWidth="85" />
                        <DataGridTemplateColumn Header="Status" Width="145" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="11"
                                            Padding="10,5"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusBadgeBackgroundConverter}}"
                                            BorderBrush="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                                     Margin="0,0,7,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="HTTPS URL" Binding="{Binding DisplayHttpsUrl}" Width="1.25*" MinWidth="210" />
                        <DataGridTextColumn Header="Profile" Binding="{Binding DisplayLaunchProfileName}" Width="115" MinWidth="100" />
                        <DataGridTextColumn Header="Environment" Binding="{Binding DisplayEnvironmentName}" Width="125" MinWidth="110" />
                        <DataGridTextColumn Header="HTTPS Port" Binding="{Binding HttpsPort}" Width="95" MinWidth="90" />
                        <DataGridTextColumn Header="Process Id" Binding="{Binding DisplayProcessId}" Width="105" MinWidth="95" />
                        <DataGridTextColumn Header="Running Since" Binding="{Binding DisplayRunningSince}" Width="125" MinWidth="115" />
                        <DataGridTextColumn Header="Last Action" Binding="{Binding LastAction}" Width="1.2*" MinWidth="190" />
                        <DataGridTextColumn Header="Repair Stage" Binding="{Binding RepairStage}" Width="120" MinWidth="105" />
                        <DataGridTemplateColumn Header="Health" Width="150" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="15" Height="15" Margin="0,0,8,0">
                                            <Ellipse Fill="{Binding Health, Converter={StaticResource HealthBrushConverter}}" Opacity="0.22" />
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding Health, Converter={StaticResource HealthBrushConverter}}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Health}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="250" MinWidth="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Content=">"
                                                ToolTip="Start service"
                                                Margin="0,0,7,0"
                                                Click="StartServiceButton_Click" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Content="[]"
                                                ToolTip="Stop service"
                                                Margin="0,0,7,0"
                                                Click="StopServiceButton_Click" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Content="R"
                                                ToolTip="Restart service"
                                                Margin="0,0,7,0"
                                                Click="RestartServiceButton_Click" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Content="Web"
                                                ToolTip="{Binding OpenUrl, TargetNullValue=URL unavailable}"
                                                Margin="0,0,7,0"
                                                Click="OpenSwaggerButton_Click" />
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Content="AI Fix"
                                                ToolTip="Run AI-assisted self-healing"
                                                Click="AIFixServiceButton_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
                </TabItem>
                <TabItem Header="Service Logs">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Background="#0D1424">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Service" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Width="200" Margin="0,0,12,0" ItemsSource="{Binding LogFileServiceNames}" SelectedItem="{Binding SelectedLogFileService}" />
                                <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ComboBox Width="130" Margin="0,0,12,0" ItemsSource="{Binding FileLogLevelFilters}" SelectedItem="{Binding SelectedFileLogLevel}" />
                                <TextBox Width="220" Margin="0,0,12,0" Text="{Binding FileLogSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search message / event code / correlation id" />
                                <Button Content="Refresh" Margin="0,0,8,0" Command="{Binding LoadServiceLogsCommand}" />
                                <Button Content="Latest Failures" Margin="0,0,8,0" Command="{Binding ShowLatestFailuresCommand}" />
                                <ToggleButton Content="Tail" Margin="0,0,8,0" IsChecked="{Binding IsLogTailEnabled}" />
                                <Button Content="Download" Margin="0,0,8,0" Command="{Binding DownloadServiceLogsCommand}" />
                                <Button Content="Open Folder" Margin="0,0,8,0" Command="{Binding OpenLogFolderCommand}" />
                                <Button Content="Rescan" Command="{Binding RefreshLogServicesCommand}" />
                            </WrapPanel>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding FileLogStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8" />

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding FileLogsView}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding DisplayTime}" Width="170" />
                                    <DataGridTextColumn Header="Level" Binding="{Binding LevelText}" Width="90" />
                                    <DataGridTextColumn Header="Event Code" Binding="{Binding EventCode}" Width="170" />
                                    <DataGridTextColumn Header="Correlation Id" Binding="{Binding CorrelationId}" Width="180" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" MinWidth="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0" x:Name="BottomPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="0"
                    Background="#0D1424"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="14,12,14,10"
                               LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LOG"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="15"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Runtime and Build Logs"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14" />
                            <TextBlock Text="{Binding LogCopyStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="12,1,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ComboBox Width="112"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding LogLevelFilters}"
                                      SelectedItem="{Binding SelectedLogLevelFilter}" />
                            <ToggleButton Content="Auto-scroll"
                                          Margin="0,0,8,0"
                                          IsChecked="{Binding IsLogAutoScrollEnabled}" />
                            <Button Content="Copy Logs"
                                    Margin="0,0,8,0"
                                    ToolTip="Copies selected log lines, or all visible lines when nothing is selected"
                                    Command="{Binding CopyLogsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=RuntimeBuildLogsList}" />
                            <Button Content="Clear Logs"
                                    Command="{Binding ClearLogsCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="1"
                            Background="#08111F"
                            CornerRadius="0,0,12,12">
                        <ListBox x:Name="RuntimeBuildLogsList"
                                 ItemsSource="{Binding LogsView}"
                                 SelectionMode="Extended"
                                 KeyDown="RuntimeBuildLogsList_KeyDown"
                                 helpers:AutoScrollBehavior.AutoScroll="{Binding IsLogAutoScrollEnabled}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 Padding="12,10"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayTime}"
                                                   Foreground="#64748B" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LevelText}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Source}"
                                                   Foreground="#94A3B8"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}"
                                                   TextWrapping="NoWrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12"
                    Background="#0D1424"
                    Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="AI Repair Panel"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,10">
                        <WrapPanel>
                            <CheckBox Content="Dry Run Mode"
                                      IsChecked="{Binding DryRunMode}"
                                      Margin="0,0,12,0" />
                            <CheckBox Content="Auto Apply"
                                      IsChecked="{Binding AutoApplyFixes}"
                                      Margin="0,0,12,0" />
                            <TextBlock Text="Max Retries"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBox Width="42"
                                     Text="{Binding MaxRepairRetries}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding AnalyticsSummary}"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.2*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Header="AI Analysis / Fix Summary" Margin="0,0,0,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AiAnalysisText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="6" />
                            </ScrollViewer>
                        </GroupBox>

                        <GroupBox Header="Repair History" Grid.Row="1">
                            <ListBox ItemsSource="{Binding RepairHistory}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#C0060B16"
              Visibility="{Binding IsAIFixBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Grid.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0"
                                             To="360"
                                             Duration="0:0:1"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border Background="#0D1424"
                    CornerRadius="14"
                    Padding="30,26"
                    BorderBrush="#256D85"
                    BorderThickness="1"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Width="58" Height="58" HorizontalAlignment="Center">
                        <Ellipse Width="58"
                                 Height="58"
                                 Stroke="#1E3A4C"
                                 StrokeThickness="5" />
                        <Ellipse Width="58"
                                 Height="58"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="5"
                                 StrokeDashCap="Round"
                                 StrokeDashArray="9 27"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="AI Fix in progress"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="{Binding AiFixStatus}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="410"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Analyzing log files and applying fixes. The window stays responsive."
                               Foreground="#64748B"
                               FontSize="11"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="410"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid></UserControl>
