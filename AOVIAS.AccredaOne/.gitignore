# AccredaOne
# These patterns are repository hygiene only.
# They do not state governance gates. See GOVERNANCE-STATUS.md.

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
credentials.json
secrets.json

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp
*~

# Logs and temporary files
*.log
tmp/
temp/

# Common build and dependency outputs.
# A pattern does not permit introducing that ecosystem.
node_modules/
vendor/
dist/
build/
out/
bin/
obj/
target/
__pycache__/
.venv/
venv/
*.pyc
.pytest_cache/
coverage/
.angular/
next-env.d.ts
