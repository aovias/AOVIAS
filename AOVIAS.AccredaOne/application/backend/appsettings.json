{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "AccredaOne": {
    "ServiceName": "AccredaOne.Api",
    "ApiVersion": "v1",
    "Phase": "DEV-04 persistence foundation"
  },
  "Persistence": {
    "EnableConnectivity": false,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30
  }
}
