# Shared / documented environment variables
# Production templates also live in deployment/environments/
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Search Console ownership (production only — leave empty until verified)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Contact email delivery (server-only; never expose to the browser) ---
# Provider: console | resend | brevo | smtp
EMAIL_PROVIDER=smtp
EMAIL_FROM="AOVIAS Website <admin@aovias.com>"
CONTACT_FORM_TO=admin@aovias.com
# Resend (swap later without Contact API changes)
RESEND_API_KEY=
# Brevo
BREVO_API_KEY=
# Hostinger Mail SMTP — see src/config/email/hostinger.settings.json for defaults
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Legacy alias still accepted: SMTP_PASS=
# Future CAPTCHA (optional)
CAPTCHA_SECRET_KEY=

# --- Release 2 integration placeholders (unused by R1 mock SDKs) ---
NEXT_PUBLIC_IDENTITY_API_URL=
NEXT_PUBLIC_COMMERCE_API_URL=
NEXT_PUBLIC_CONTACT_API_URL=
NEXT_PUBLIC_KNOWLEDGE_API_URL=
NEXT_PUBLIC_SEARCH_API_URL=
NEXT_PUBLIC_ANALYTICS_API_URL=
NEXT_PUBLIC_ANALYTICS_PROVIDER=mock

# --- Feature flags (default: mocks on, live off) ---
NEXT_PUBLIC_FF_USE_MOCK_SDKS=true
NEXT_PUBLIC_FF_IDENTITY_LIVE=false
NEXT_PUBLIC_FF_COMMERCE_LIVE=false
# Contact form posts to /api/contact regardless; keep true when email is configured
NEXT_PUBLIC_FF_CONTACT_LIVE=true
NEXT_PUBLIC_FF_KNOWLEDGE_LIVE=false
NEXT_PUBLIC_FF_SEARCH_LIVE=false
# Telemetry — keep false for Release 1 (no live collectors)
NEXT_PUBLIC_FF_ANALYTICS=false
# Optional: log mock telemetry events in development
NEXT_PUBLIC_TELEMETRY_DEBUG=false

# Operations
MAINTENANCE_MODE=false
